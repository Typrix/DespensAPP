# -*- coding: utf-8 -*-
# =========================================================
# Pantalla: Despensa / Inventario (cupboard) - DespensAPP
# Buscador + filtros rápidos + secciones por urgencia
# =========================================================

<PantryScreen@MDScreen>:
    name: "cupboard"

    MDScrollView:
        do_scroll_x: False
        bar_width: 0

        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            spacing: "10dp"

            # Encabezado de Sección
            BoxLayout:
                size_hint_y: None
                height: "46dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    Label:
                        text: "INVENTARIO"
                        font_size: "10sp"
                        bold: True
                        color: app.category_tag_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    Label:
                        text: "Mi despensa"
                        font_size: "22sp"
                        bold: True
                        color: app.text_primary_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                AddCircleButton:
                    pos_hint: {"center_y": 0.5}
                    on_release: app.accion_agregar()

            # Buscador (sin distinguir mayúsculas ni tildes)
            BoxLayout:
                size_hint_y: None
                height: "42dp"
                padding: ["12dp", 0, "4dp", 0]
                spacing: "6dp"
                canvas.before:
                    Color:
                        rgba: app.card_white_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]
                MDIcon:
                    icon: "magnify"
                    size_hint_x: None
                    width: "22dp"
                    font_size: "20sp"
                    theme_text_color: "Custom"
                    text_color: app.text_secondary_color
                    pos_hint: {"center_y": 0.5}
                TextInput:
                    id: pantry_search_input
                    hint_text: "Buscar en tu despensa..."
                    multiline: False
                    write_tab: False
                    font_size: "13.5sp"
                    padding: ["4dp", "12dp", "4dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color
                    on_text: app.buscar_despensa(self.text)
                MDIconButton:
                    icon: "close-circle"
                    style: "standard"
                    theme_icon_color: "Custom"
                    icon_color: app.text_secondary_color
                    pos_hint: {"center_y": 0.5}
                    opacity: 1 if pantry_search_input.text else 0
                    disabled: not pantry_search_input.text
                    on_release: pantry_search_input.text = ""

            # Filtros rápidos (desplazables en horizontal)
            ScrollView:
                size_hint_y: None
                height: "34dp"
                do_scroll_y: False
                bar_width: 0
                BoxLayout:
                    id: pantry_filters_container
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: "8dp"

            # Reponer en bloque lo que está por agotarse o sin stock
            TapCard:
                size_hint_y: None
                height: "40dp" if app.pantry_restock_count else 0
                opacity: 1 if app.pantry_restock_count else 0
                disabled: not app.pantry_restock_count
                padding: ["12dp", 0, "12dp", 0]
                spacing: "8dp"
                on_release: app.reponer_todo_despensa()
                canvas.before:
                    Color:
                        rgba: [0.82, 0.48, 0.12, 0.16 if app.modo_oscuro else 0.12]
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]
                MDIcon:
                    icon: "playlist-plus"
                    size_hint_x: None
                    width: "22dp"
                    font_size: "20sp"
                    theme_text_color: "Custom"
                    text_color: [0.95, 0.65, 0.30, 1.0] if app.modo_oscuro else [0.72, 0.40, 0.08, 1.0]
                    pos_hint: {"center_y": 0.5}
                Label:
                    text: app.pantry_restock_text
                    font_size: "12.5sp"
                    bold: True
                    color: [0.95, 0.65, 0.30, 1.0] if app.modo_oscuro else [0.72, 0.40, 0.08, 1.0]
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    shorten: True

            # Contenedor dinámico: secciones por urgencia con sus productos
            MDBoxLayout:
                id: pantry_items_container
                orientation: "vertical"
                adaptive_height: True
                spacing: "4dp"
