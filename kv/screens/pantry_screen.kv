# -*- coding: utf-8 -*-
# =========================================================
# Pantalla: Despensa / Inventario (cupboard) - DespensAPP
# =========================================================

<PantryScreen@MDScreen>:
    name: "cupboard"

    MDScrollView:
        do_scroll_x: False
        bar_width: 0

        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            spacing: "10dp"

            # Encabezado de Sección
            BoxLayout:
                size_hint_y: None
                height: "46dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    Label:
                        text: "INVENTARIO"
                        font_size: "10sp"
                        bold: True
                        color: app.category_tag_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    Label:
                        text: "Mi despensa"
                        font_size: "22sp"
                        bold: True
                        color: app.text_primary_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                AddCircleButton:
                    pos_hint: {"center_y": 0.5}
                    on_release: app.accion_agregar()

            Widget:
                size_hint_y: None
                height: "6dp"

            # Contenedor Dinámico de Productos de Despensa
            MDBoxLayout:
                id: pantry_items_container
                orientation: "vertical"
                adaptive_height: True
                spacing: "4dp"
