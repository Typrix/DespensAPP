# -*- coding: utf-8 -*-
# =========================================================
# Pantalla: Listas de Compras (lists) - DespensAPP
# =========================================================

<ListsScreen@MDScreen>:
    name: "lists"

    MDScrollView:
        do_scroll_x: False
        bar_width: 0

        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            spacing: "14dp"

            # Encabezado de Sección
            BoxLayout:
                size_hint_y: None
                height: "46dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    Label:
                        text: "ORGANIZACIÓN"
                        font_size: "10sp"
                        bold: True
                        color: app.category_tag_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    Label:
                        text: "Mis listas"
                        font_size: "22sp"
                        bold: True
                        color: app.text_primary_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                AddCircleButton:
                    pos_hint: {"center_y": 0.5}
                    on_release: app.accion_agregar()

            # Contenedor Dinámico de Listas
            MDBoxLayout:
                id: shopping_lists_container
                orientation: "vertical"
                adaptive_height: True
                spacing: "12dp"
