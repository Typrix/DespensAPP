# -*- coding: utf-8 -*-
# =========================================================
# Pantalla: Listas de Compras (lists) - DespensAPP
# =========================================================

<ListsScreen@MDScreen>:
    name: "lists"

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1
        padding: ["16dp", "0dp", "16dp", "0dp"]

        # Contenido directo sobre el fondo, de borde a borde (sin panel contenedor)
        BoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            padding: [0, "4dp", 0, 0]
            spacing: "10dp"

            MDScrollView:
                do_scroll_x: False
                bar_width: 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: "14dp"

                    # Encabezado de Sección
                    BoxLayout:
                        size_hint_y: None
                        height: "48dp"

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: 1
                            Label:
                                text: "Mis listas"
                                font_size: "26sp"
                                bold: True
                                color: app.text_primary_color
                                halign: "left"
                                valign: "middle"
                                text_size: self.size

                    # Contenedor Dinámico de Listas
                    MDBoxLayout:
                        id: shopping_lists_container
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "12dp"

                    # Espacio final para que el botón flotante no tape la última fila
                    Widget:
                        size_hint_y: None
                        height: "76dp"

    # Agregar: botón flotante sobre el contenido
    AddCircleButton:
        # Coordenadas relativas a la pantalla (MDScreen es un RelativeLayout)
        pos: self.parent.width - self.width - dp(16), dp(16)
        on_release: app.accion_agregar()
