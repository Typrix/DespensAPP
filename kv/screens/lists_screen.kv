# -*- coding: utf-8 -*-
# =========================================================
# Pantalla: Listas de Compras (lists) - DespensAPP
# =========================================================

<ListsScreen@MDScreen>:
    name: "lists"

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1
        padding: ["14dp", "4dp", "14dp", "8dp"]

        BoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            padding: ["16dp", "16dp", "16dp", "16dp"]
            spacing: "10dp"
            canvas.before:
                Color:
                    rgba: app.sage_container_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [28, 28, 28, 28]

            MDScrollView:
                do_scroll_x: False
                bar_width: 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: "14dp"

                    # Encabezado de Sección
                    BoxLayout:
                        size_hint_y: None
                        height: "46dp"

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: 1
                            Label:
                                text: "ORGANIZACIÓN"
                                font_size: "10sp"
                                bold: True
                                color: app.category_tag_color
                                halign: "left"
                                valign: "middle"
                                text_size: self.size
                            Label:
                                text: "Mis listas"
                                font_size: "22sp"
                                bold: True
                                color: app.text_primary_color
                                halign: "left"
                                valign: "middle"
                                text_size: self.size

                        AddCircleButton:
                            pos_hint: {"center_y": 0.5}
                            on_release: app.accion_agregar()

                    # Contenedor Dinámico de Listas
                    MDBoxLayout:
                        id: shopping_lists_container
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "12dp"
