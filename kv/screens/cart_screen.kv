# -*- coding: utf-8 -*-
# =========================================================
# Pantalla: Carrito de Compras (cart) - DespensAPP
# =========================================================

<CartScreen@MDScreen>:
    name: "cart"

    MDScrollView:
        do_scroll_x: False
        bar_width: 0

        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            spacing: "10dp"

            # Encabezado de Sección
            BoxLayout:
                size_hint_y: None
                height: "46dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    Label:
                        text: "COMPRA ACTUAL"
                        font_size: "10sp"
                        bold: True
                        color: app.category_tag_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    Label:
                        text: "Carrito de compras"
                        font_size: "22sp"
                        bold: True
                        color: app.text_primary_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                AddCircleButton:
                    pos_hint: {"center_y": 0.5}
                    on_release: app.accion_agregar()

            Widget:
                size_hint_y: None
                height: "6dp"

            # Contenedor Dinámico de Artículos del Carrito
            MDBoxLayout:
                id: cart_items_container
                orientation: "vertical"
                adaptive_height: True
                spacing: "4dp"

            Widget:
                size_hint_y: None
                height: "16dp"

            # Fila de Total Estimado
            BoxLayout:
                size_hint_y: None
                height: "36dp"
                Label:
                    text: "En el carro"
                    font_size: "13sp"
                    color: app.text_secondary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: app.total_carrito_str
                    font_size: "24sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "right"
                    valign: "middle"
                    text_size: self.size

            # Detalle: total estimado de todo el carrito y avance
            Label:
                text: app.cart_total_detail
                font_size: "11.5sp"
                color: app.text_secondary_color
                size_hint_y: None
                height: "18dp" if app.cart_total_detail else 0
                halign: "right"
                valign: "top"
                text_size: self.size

            # Finalizar compra: pasa lo marcado a la despensa y al historial
            Button:
                text: f"Finalizar compra ({app.cart_checked_count})"
                font_size: "14sp"
                bold: True
                size_hint_y: None
                height: "46dp" if app.cart_checked_count else 0
                opacity: 1 if app.cart_checked_count else 0
                disabled: not app.cart_checked_count
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: app.abrir_finalizar_compra()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Label:
                text: "Marca lo que ya echaste al carro y finaliza la compra para sumarlo a tu despensa."
                font_size: "11sp"
                color: app.text_secondary_color
                size_hint_y: None
                height: self.texture_size[1] + dp(6) if app.cart_has_items and not app.cart_checked_count else 0
                opacity: 1 if app.cart_has_items and not app.cart_checked_count else 0
                halign: "center"
                text_size: self.width, None
