# -*- coding: utf-8 -*-
# ========================================================
# Diálogos y Modales Visuales para DespensAPP
# ========================================================
#:import numeric_input_filter controllers.validators.numeric_input_filter

<BaseFormModal>:
    size_hint: None, None
    width: "350dp"
    background_color: [0, 0, 0, 0.45]
    background: ""
    auto_dismiss: True

# Mensaje de validación del formulario (rojo = error, ámbar = aviso).
# Ocupa espacio solo cuando hay texto.
<FormMessageLabel@Label>:
    is_warning: False
    font_size: "12sp"
    bold: True
    color: [0.82, 0.48, 0.12, 1.0] if self.is_warning else [0.85, 0.20, 0.25, 1.0]
    size_hint_y: None
    height: (self.texture_size[1] + dp(6)) if self.text else 0
    opacity: 1 if self.text else 0
    halign: "center"
    valign: "middle"
    text_size: self.width, None

<CustomInputField@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: "56dp"
    spacing: "4dp"
    label_text: ""
    hint_text: ""
    input_text: ""
    input_filter: None

    Label:
        text: root.label_text
        font_size: "11sp"
        bold: True
        color: app.text_secondary_color
        size_hint_y: None
        height: "16dp"
        halign: "left"
        text_size: self.size

    AnchorLayout:
        size_hint_y: None
        height: "36dp"
        canvas.before:
            Color:
                rgba: app.sage_container_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10, 10, 10, 10]
            Color:
                rgba: app.divider_color
            Line:
                rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                width: 1.0

        TextInput:
            id: text_input
            text: root.input_text
            hint_text: root.hint_text
            input_filter: root.input_filter
            multiline: False
            font_size: "13.5sp"
            padding: ["10dp", "8dp", "10dp", "8dp"]
            background_color: [0, 0, 0, 0]
            cursor_color: app.accent_green_color
            foreground_color: app.input_text_color
            hint_text_color: app.input_placeholder_color


# --------------------------------------------------------
# 1. Modal: Añadir al Carrito
# --------------------------------------------------------
<AddCartItemModal>:
    height: "404dp" if root.error_text else "360dp"

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "12dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        # Encabezado
        BoxLayout:
            size_hint_y: None
            height: "32dp"
            Label:
                text: root.title_text
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size

        # Campo: Nombre del producto
        CustomInputField:
            id: field_title
            label_text: "PRODUCTO"
            hint_text: "Ej: Queso gouda, Manzanas..."

        # Fila: Precio y Categoría/Lista
        BoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "10dp"

            CustomInputField:
                id: field_price
                label_text: "PRECIO ($)"
                hint_text: "Ej: 2.500 (opcional)"
                input_filter: numeric_input_filter

            CustomInputField:
                id: field_subtitle
                label_text: "LISTA / CATEGORÍA"
                hint_text: "Ej: Despensa, Frutas..."

        Widget:
            size_hint_y: 1

        FormMessageLabel:
            text: root.error_text

        # Botones de Acción
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13.5sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: root.submit_text
                font_size: "13.5sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 2. Modal: Añadir a la Despensa (Con Umbrales y Fecha de Vencimiento)
# --------------------------------------------------------
<AddPantryItemModal>:
    height: dp(530) + (dp(44) if root.error_text else 0) + (dp(26) if root.warning_text else 0)

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        # Encabezado
        BoxLayout:
            size_hint_y: None
            height: "32dp"
            Label:
                text: "Añadir a Despensa"
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size

        # Campo: Nombre del producto
        CustomInputField:
            id: field_name
            label_text: "NOMBRE DEL PRODUCTO"
            hint_text: "Ej: Leche descremada, Arroz, Sal..."

        # Fila: Cantidad Actual y Unidad
        BoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "10dp"

            CustomInputField:
                id: field_quantity
                label_text: "CANTIDAD ACTUAL"
                hint_text: "Ej: 2, 1,5, 500"
                input_filter: numeric_input_filter

            # Selector de unidad: menú desplegable con unidades predefinidas
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "56dp"
                spacing: "4dp"

                Label:
                    text: "UNIDAD"
                    font_size: "11sp"
                    bold: True
                    color: app.text_secondary_color
                    size_hint_y: None
                    height: "16dp"
                    halign: "left"
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: "36dp"
                    canvas.before:
                        Color:
                            rgba: app.sage_container_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10, 10, 10, 10]
                        Color:
                            rgba: app.divider_color
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                            width: 1.0

                    Button:
                        id: field_unit
                        text: root.selected_unit
                        font_size: "13.5sp"
                        color: app.input_text_color
                        background_color: [0, 0, 0, 0]
                        halign: "left"
                        valign: "middle"
                        text_size: self.width - dp(20), self.height
                        on_release: root.open_unit_menu(self)

                    MDIconButton:
                        icon: "menu-down"
                        style: "standard"
                        theme_icon_color: "Custom"
                        icon_color: app.accent_green_color
                        pos_hint: {"center_y": 0.5}
                        on_release: root.open_unit_menu(field_unit)

        # Campo: Umbral Mínimo Numérico (Para clasificar alerta)
        CustomInputField:
            id: field_threshold
            label_text: "CANTIDAD MÍNIMA (ALERTA)"
            hint_text: "Si baja de este número, alertará"
            input_filter: numeric_input_filter

        # Campo: Fecha de Vencimiento con selector de calendario integrado
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "56dp"
            spacing: "4dp"

            Label:
                text: "FECHA DE VENCIMIENTO"
                font_size: "11sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp"
                halign: "left"
                text_size: self.size

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: "4dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                    Color:
                        rgba: app.divider_color
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                        width: 1.0

                TextInput:
                    id: field_expiration_input
                    text: root.expiration_date_str
                    hint_text: "No vence (no perecible)" if root.has_no_expiration else "Toca el calendario (AAAA-MM-DD)"
                    disabled: root.has_no_expiration
                    multiline: False
                    font_size: "13.5sp"
                    padding: ["10dp", "8dp", "6dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color
                    size_hint_x: 1

                MDIconButton:
                    icon: "calendar-month-outline"
                    style: "standard"
                    theme_icon_color: "Custom"
                    icon_color: app.accent_green_color if not root.has_no_expiration else app.text_secondary_color
                    disabled: root.has_no_expiration
                    pos_hint: {"center_y": 0.5}
                    on_release: root.open_date_picker()

        # Botón / Toggle: Sin fecha de vencimiento
        BoxLayout:
            size_hint_y: None
            height: "32dp"

            Button:
                text: "No perecible: sin fecha de vencimiento (tocar para quitar)" if root.has_no_expiration else "Marcar como 'Sin fecha de vencimiento'"
                font_size: "11sp"
                bold: root.has_no_expiration
                color: app.accent_green_color if root.has_no_expiration else app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.toggle_no_expiration()
                canvas.before:
                    Color:
                        rgba: [0.88, 0.96, 0.90, 1.0] if root.has_no_expiration else app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]

        Widget:
            size_hint_y: 1

        # Aviso (ámbar) si el producto ya venció y error de validación (rojo)
        FormMessageLabel:
            text: root.warning_text
            is_warning: True

        FormMessageLabel:
            text: root.error_text

        # Botones de Acción
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13.5sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: "Guardar"
                font_size: "13.5sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 2B. Modal: Gestionar Producto de Despensa (Stock, Vencimiento, Eliminar)
# --------------------------------------------------------
<PantryItemDetailModal>:
    # El alto se ajusta al contenido (vista o edición)
    height: content.minimum_height

    BoxLayout:
        id: content
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: ["20dp", "16dp", "20dp", "16dp"]
        spacing: "12dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        # Encabezado: nombre + estado, editar y cerrar
        BoxLayout:
            size_hint_y: None
            height: "50dp"
            spacing: "4dp"

            BoxLayout:
                orientation: "vertical"
                spacing: "4dp"
                Label:
                    text: root.item_name
                    font_size: "18sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    shorten: True
                    shorten_from: "right"
                AnchorLayout:
                    anchor_x: "left"
                    size_hint_y: None
                    height: "20dp"
                    Label:
                        text: root.status_str
                        font_size: "11sp"
                        bold: True
                        color: root.status_text_color
                        size_hint: None, None
                        size: self.texture_size[0] + dp(16), dp(20)
                        canvas.before:
                            Color:
                                rgba: root.status_color[:3] + [0.22 if app.modo_oscuro else 0.14]
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10, 10, 10, 10]

            MDIconButton:
                icon: "pencil-outline"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: app.accent_green_color
                pos_hint: {"center_y": 0.5}
                opacity: 0 if root.is_editing else 1
                disabled: root.is_editing
                on_release: root.start_edit()

            MDIconButton:
                icon: "close"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()

        # Cuerpo: se intercambia entre vista (view_box) y edición (edit_box)
        BoxLayout:
            id: body
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height

            # ================= VISTA =================
            BoxLayout:
                id: view_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"

                # Tarjeta de stock
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["12dp", "10dp", "12dp", "10dp"]
                    spacing: "8dp"
                    canvas.before:
                        Color:
                            rgba: app.sage_container_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [16, 16, 16, 16]

                    Label:
                        text: "STOCK ACTUAL"
                        font_size: "11sp"
                        bold: True
                        color: app.text_secondary_color
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    # Stepper: [- paso] cantidad [+ paso]
                    BoxLayout:
                        size_hint_y: None
                        height: "50dp"
                        spacing: "10dp"

                        Button:
                            text: f"-{root.step_display}"
                            font_size: "16sp"
                            bold: True
                            size_hint_x: None
                            width: "68dp"
                            color: app.text_primary_color
                            background_color: [0, 0, 0, 0]
                            disabled: root.quantity_val <= 0
                            opacity: 0.4 if self.disabled else 1
                            on_release: root.change_qty(-1)
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12, 12, 12, 12]

                        Label:
                            text: root.qty_display
                            font_size: "24sp"
                            bold: True
                            color: app.text_primary_color
                            halign: "center"
                            valign: "middle"
                            text_size: self.size
                            shorten: True

                        Button:
                            text: f"+{root.step_display}"
                            font_size: "16sp"
                            bold: True
                            size_hint_x: None
                            width: "68dp"
                            color: [1, 1, 1, 1]
                            background_color: [0, 0, 0, 0]
                            on_release: root.change_qty(+1)
                            canvas.before:
                                Color:
                                    rgba: app.accent_green_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12, 12, 12, 12]

                    # Cantidad exacta (ej: compraste 2,5 kg)
                    BoxLayout:
                        size_hint_y: None
                        height: "40dp"
                        spacing: "8dp"

                        AnchorLayout:
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]
                            TextInput:
                                id: exact_qty_input
                                hint_text: f"Escribir cantidad en {root.unit}"
                                input_filter: numeric_input_filter
                                multiline: False
                                font_size: "13.5sp"
                                padding: ["12dp", "11dp", "10dp", "8dp"]
                                background_color: [0, 0, 0, 0]
                                cursor_color: app.accent_green_color
                                foreground_color: app.input_text_color
                                hint_text_color: app.input_placeholder_color
                                on_text_validate: root.set_exact_qty()

                        Button:
                            text: "Fijar"
                            font_size: "13sp"
                            bold: True
                            size_hint_x: None
                            width: "68dp"
                            color: app.accent_green_color
                            background_color: [0, 0, 0, 0]
                            on_release: root.set_exact_qty()
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]

                    # Mínimo que dispara la alerta
                    BoxLayout:
                        size_hint_y: None
                        height: "18dp"
                        spacing: "6dp"
                        MDIcon:
                            icon: "bell-outline"
                            font_size: "15sp"
                            theme_text_color: "Custom"
                            text_color: app.text_secondary_color
                            size_hint_x: None
                            width: "16dp"
                            pos_hint: {"center_y": 0.5}
                        Label:
                            text: root.threshold_hint
                            font_size: "11.5sp"
                            color: app.text_secondary_color
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                # Tarjeta de vencimiento
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["12dp", "10dp", "12dp", "10dp"]
                    spacing: "10dp"
                    canvas.before:
                        Color:
                            rgba: app.sage_container_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [16, 16, 16, 16]

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "10dp"
                        AnchorLayout:
                            size_hint: None, None
                            size: "36dp", "36dp"
                            pos_hint: {"center_y": 0.5}
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]
                            MDIcon:
                                icon: "calendar-clock-outline" if root.has_expiration else "infinity"
                                font_size: "19sp"
                                theme_text_color: "Custom"
                                text_color: root.exp_color
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: root.exp_title
                                font_size: "13.5sp"
                                bold: True
                                color: app.text_primary_color
                                halign: "left"
                                valign: "bottom"
                                text_size: self.size
                            Label:
                                text: root.exp_desc
                                font_size: "11.5sp"
                                bold: True
                                color: root.exp_color
                                halign: "left"
                                valign: "top"
                                text_size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        Button:
                            text: "Cambiar fecha" if root.has_expiration else "Agregar fecha"
                            font_size: "12.5sp"
                            bold: True
                            color: app.accent_green_color
                            background_color: [0, 0, 0, 0]
                            on_release: root.edit_expiration()
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]

                        Button:
                            text: "No vence"
                            font_size: "12.5sp"
                            color: app.text_secondary_color
                            background_color: [0, 0, 0, 0]
                            size_hint_x: 1 if root.has_expiration else 0.001
                            opacity: 1 if root.has_expiration else 0
                            disabled: not root.has_expiration
                            on_release: root.clear_expiration()
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]

                # Reponer: solo si el stock está bajo o agotado
                Button:
                    text: root.restock_text
                    font_size: "13sp"
                    bold: True
                    size_hint_y: None
                    height: "44dp" if root.needs_restock else 0
                    opacity: 1 if root.needs_restock else 0
                    disabled: not root.needs_restock or root.restock_text != "Añadir al carrito"
                    disabled_color: app.text_secondary_color
                    color: app.accent_green_color
                    background_color: [0, 0, 0, 0]
                    on_release: root.add_to_cart()
                    canvas.before:
                        Color:
                            rgba: app.active_pill_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12, 12, 12, 12]

                FormMessageLabel:
                    text: root.error_text

                Button:
                    text: "Listo"
                    font_size: "14sp"
                    bold: True
                    size_hint_y: None
                    height: "46dp"
                    color: [1, 1, 1, 1]
                    background_color: [0, 0, 0, 0]
                    on_release: root.dismiss()
                    canvas.before:
                        Color:
                            rgba: app.accent_green_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14, 14, 14, 14]

                # Acción destructiva secundaria (con "Deshacer")
                Button:
                    text: "Eliminar producto"
                    font_size: "12.5sp"
                    size_hint_y: None
                    height: "30dp"
                    color: [0.85, 0.25, 0.25, 1.0]
                    background_color: [0, 0, 0, 0]
                    on_release: root.delete_item()

            # ================= EDICIÓN =================
            BoxLayout:
                id: edit_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"

                CustomInputField:
                    id: edit_name
                    label_text: "NOMBRE"
                    hint_text: "Ej: Arroz integral"

                BoxLayout:
                    size_hint_y: None
                    height: "56dp"
                    spacing: "10dp"

                    # Unidad (menú desplegable)
                    BoxLayout:
                        orientation: "vertical"
                        spacing: "4dp"
                        Label:
                            text: "UNIDAD"
                            font_size: "11sp"
                            bold: True
                            color: app.text_secondary_color
                            size_hint_y: None
                            height: "16dp"
                            halign: "left"
                            text_size: self.size
                        BoxLayout:
                            size_hint_y: None
                            height: "36dp"
                            canvas.before:
                                Color:
                                    rgba: app.sage_container_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]
                            Button:
                                id: edit_unit_btn
                                text: root.edit_unit
                                font_size: "13.5sp"
                                color: app.input_text_color
                                background_color: [0, 0, 0, 0]
                                halign: "left"
                                valign: "middle"
                                text_size: self.width - dp(20), self.height
                                on_release: root.open_edit_unit_menu(self.parent)
                            MDIconButton:
                                icon: "menu-down"
                                style: "standard"
                                theme_icon_color: "Custom"
                                icon_color: app.accent_green_color
                                pos_hint: {"center_y": 0.5}
                                on_release: root.open_edit_unit_menu(self.parent)

                    CustomInputField:
                        id: edit_threshold
                        label_text: "AVISAR SI BAJA DE"
                        hint_text: "Ej: 2"
                        input_filter: numeric_input_filter

                Label:
                    text: "La cantidad y la fecha de vencimiento no cambian al editar."
                    font_size: "11sp"
                    color: app.text_secondary_color
                    size_hint_y: None
                    height: "16dp"
                    halign: "left"
                    text_size: self.size

                FormMessageLabel:
                    text: root.error_text

                BoxLayout:
                    size_hint_y: None
                    height: "44dp"
                    spacing: "10dp"

                    Button:
                        text: "Cancelar"
                        font_size: "13.5sp"
                        color: app.text_secondary_color
                        background_color: [0, 0, 0, 0]
                        on_release: root.cancel_edit()
                        canvas.before:
                            Color:
                                rgba: app.sage_container_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14, 14, 14, 14]

                    Button:
                        text: "Guardar cambios"
                        font_size: "13.5sp"
                        bold: True
                        color: [1, 1, 1, 1]
                        background_color: [0, 0, 0, 0]
                        on_release: root.save_edit()
                        canvas.before:
                            Color:
                                rgba: app.accent_green_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 2C. Modal: Edición Genérica de Texto (Nombre o Fecha)
# --------------------------------------------------------
<EditItemModal>:
    height: "270dp" if root.error_text else "230dp"

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "12dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        Label:
            text: root.title_text
            font_size: "14.5sp"
            bold: True
            color: app.text_primary_color
            size_hint_y: None
            height: "26dp"
            halign: "left"
            text_size: self.size

        CustomInputField:
            id: field_edit
            label_text: "NUEVO VALOR"
            hint_text: "Escribe aquí..."

        Widget:
            size_hint_y: 1

        FormMessageLabel:
            text: root.error_text

        BoxLayout:
            size_hint_y: None
            height: "40dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

            Button:
                text: "Guardar"
                font_size: "13sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]


# --------------------------------------------------------
# 3. Modal: Nueva Lista de Compras (Con Productos Iniciales)
# --------------------------------------------------------
<AddShoppingListModal>:
    height: "484dp" if root.error_text else "440dp"

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        # Encabezado
        BoxLayout:
            size_hint_y: None
            height: "30dp"
            Label:
                text: "Nueva Lista de Compras"
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size

        # Campo: Nombre de la lista
        CustomInputField:
            id: field_name
            label_text: "NOMBRE DE LA LISTA"
            hint_text: "Ej: Supermercado Lunes, Asado, Verdulería..."

        # Campo opcional: Productos iniciales
        CustomInputField:
            id: field_initial_items
            label_text: "PRODUCTOS INICIALES (OPCIONAL)"
            hint_text: "Ej: Leche, Pan, Huevos, Café (separados por coma)"

        # Selector de Color para el Icono
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "60dp"
            spacing: "6dp"

            Label:
                text: "COLOR DEL ICONO"
                font_size: "11sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp"
                halign: "left"
                text_size: self.size

            BoxLayout:
                id: color_chips_box
                size_hint_y: None
                height: "36dp"
                spacing: "10dp"

        Widget:
            size_hint_y: 1

        FormMessageLabel:
            text: root.error_text

        # Botones de Acción
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13.5sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: "Crear Lista"
                font_size: "13.5sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 3B. Fila de Producto Anotado en Lista de Supermercado
# --------------------------------------------------------
<ShoppingListItemRow>:
    size_hint_y: None
    height: "46dp"
    spacing: "8dp"
    padding: ["10dp", "4dp", "10dp", "4dp"]
    canvas.before:
        Color:
            # En modo oscuro usa sage_container_color (tono azul medianoche #1D293D)
            # En modo claro usa el gris claro sutil original
            rgba: (app.sage_container_color if not root.is_checked else [0.15, 0.22, 0.32, 0.7]) if app.modo_oscuro else ([0.95, 0.96, 0.95, 1.0] if not root.is_checked else [0.91, 0.92, 0.91, 0.7])
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

    # Botón Circular de Check / Tachado (icono Material: Roboto no trae el glifo ✓)
    TapArea:
        size_hint: None, None
        size: "28dp", "28dp"
        pos_hint: {"center_y": 0.5}
        on_release: root.toggle()
        canvas.before:
            Color:
                rgba: app.accent_green_color if root.is_checked else ([0.30, 0.40, 0.55, 1.0] if app.modo_oscuro else [0.75, 0.78, 0.76, 1.0])
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [14, 14, 14, 14]
        AnchorLayout:
            MDIcon:
                icon: "check"
                font_size: "18sp"
                theme_text_color: "Custom"
                text_color: [1, 1, 1, 1]
                opacity: 1 if root.is_checked else 0
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

    # Nombre del Producto (con tachado si ya se compró)
    Label:
        text: f"[s]{root.name}[/s]" if root.is_checked else root.name
        markup: True
        font_size: "13.5sp"
        # Si está tachado, usa un color secundario adaptativo; si está activo, usa el color principal del tema
        color: app.text_secondary_color if root.is_checked else app.text_primary_color
        size_hint_x: 1
        halign: "left"
        valign: "middle"
        text_size: self.size

    # Botón de Edición Rápida
    MDIconButton:
        icon: "pencil-outline"
        style: "standard"
        theme_icon_color: "Custom"
        icon_color: app.text_secondary_color
        pos_hint: {"center_y": 0.5}
        on_release: root.edit()

    # Botón Eliminar Producto
    MDIconButton:
        icon: "close"
        style: "standard"
        theme_icon_color: "Custom"
        icon_color: [0.85, 0.25, 0.25, 0.85]
        pos_hint: {"center_y": 0.5}
        on_release: root.delete()


# --------------------------------------------------------
# 3C. Modal: Detalle de Lista de Supermercado (Estilo Papel)
# --------------------------------------------------------
<ShoppingListDetailModal>:
    width: "360dp"
    height: "560dp"

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        # Cabecera de la Lista
        BoxLayout:
            size_hint_y: None
            height: "36dp"
            spacing: "8dp"

            # Indicador circular de color
            Widget:
                size_hint: None, None
                size: "14dp", "14dp"
                pos_hint: {"center_y": 0.5}
                canvas.before:
                    Color:
                        rgba: root.icon_color_rgba
                    Ellipse:
                        pos: self.pos
                        size: self.size

            Label:
                text: root.list_name
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                size_hint_x: 1
                halign: "left"
                valign: "middle"
                text_size: self.size

            MDIconButton:
                icon: "pencil-outline"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}
                on_release: root.edit_list_name()

            MDIconButton:
                icon: "trash-can-outline"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: [0.85, 0.25, 0.25, 0.9]
                pos_hint: {"center_y": 0.5}
                on_release: root.delete_this_list()

        # Subtítulo (contador de items y tachados)
        Label:
            text: root.subtitle_info
            font_size: "12sp"
            color: app.text_secondary_color
            size_hint_y: None
            height: "18dp"
            halign: "left"
            text_size: self.size

        # Fila para Anotar Producto Rápido (Estilo Papel)
        BoxLayout:
            size_hint_y: None
            height: "40dp"
            spacing: "8dp"

            AnchorLayout:
                size_hint_x: 1
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]
                    Color:
                        rgba: app.divider_color
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
                        width: 1.0

                TextInput:
                    id: new_item_input
                    hint_text: "Anotar producto (ej: Huevos)..."
                    multiline: False
                    font_size: "13sp"
                    padding: ["10dp", "8dp", "10dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color
                    on_text_validate: root.add_item()

            Button:
                text: "+"
                font_size: "20sp"
                bold: True
                size_hint: None, None
                size: "40dp", "40dp"
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.add_item()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

        # Mensaje de validación al anotar producto
        FormMessageLabel:
            text: root.error_text

        # Separador sutil
        Widget:
            size_hint_y: None
            height: "1dp"
            canvas.before:
                Color:
                    rgba: app.divider_color
                Rectangle:
                    pos: self.pos
                    size: self.size

        # Lista Scrollable de Productos Anotados
        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                id: items_list_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "6dp"

        # Pie: Cerrar + Pasar al carrito (solo si hay productos sin tachar)
        BoxLayout:
            size_hint_y: None
            height: "40dp"
            spacing: "10dp"

            Button:
                text: "Cerrar"
                font_size: "13sp"
                bold: True
                color: app.text_primary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

            Button:
                text: f"Pasar al carrito ({root.pending_count})"
                font_size: "13sp"
                bold: True
                size_hint_x: 1.4 if root.pending_count else 0.001
                opacity: 1 if root.pending_count else 0
                disabled: not root.pending_count
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.send_to_cart()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]


# --------------------------------------------------------
# 4. Modal: Cuenta de Usuario (Inicio de Sesión y Registro)
# --------------------------------------------------------
<AuthModal>:
    height: "545dp"
    auto_dismiss: root.can_cancel

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        # Encabezado con Título
        BoxLayout:
            size_hint_y: None
            height: "28dp"
            Label:
                text: "Bienvenido/a a DespensAPP"
                font_size: "16.5sp"
                bold: True
                color: app.text_primary_color
                halign: "center"
                valign: "middle"
                text_size: self.size

        # Selector de Pestaña: Iniciar Sesión / Crear Cuenta
        BoxLayout:
            size_hint_y: None
            height: "38dp"
            spacing: "6dp"
            canvas.before:
                Color:
                    rgba: app.sage_container_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14, 14, 14, 14]

            Button:
                id: btn_tab_login
                text: "Iniciar Sesión"
                bold: True
                font_size: "12.5sp"
                color: app.accent_green_color if root.is_login_mode else app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.set_mode(True)
                canvas.before:
                    Color:
                        rgba: app.card_white_color if root.is_login_mode else [0, 0, 0, 0]
                    RoundedRectangle:
                        pos: [self.x + 3, self.y + 3]
                        size: [self.width - 6, self.height - 6]
                        radius: [12, 12, 12, 12]

            Button:
                id: btn_tab_register
                text: "Crear Cuenta"
                bold: True
                font_size: "12.5sp"
                color: app.accent_green_color if not root.is_login_mode else app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.set_mode(False)
                canvas.before:
                    Color:
                        rgba: app.card_white_color if not root.is_login_mode else [0, 0, 0, 0]
                    RoundedRectangle:
                        pos: [self.x + 3, self.y + 3]
                        size: [self.width - 6, self.height - 6]
                        radius: [12, 12, 12, 12]

        # Campo: Nombre (Solo en modo registro)
        BoxLayout:
            id: box_name
            orientation: "vertical"
            size_hint_y: None
            height: "56dp" if not root.is_login_mode else "0dp"
            opacity: 1 if not root.is_login_mode else 0
            disabled: root.is_login_mode

            Label:
                text: "NOMBRE COMPLETO"
                font_size: "11sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp" if not root.is_login_mode else "0dp"
                halign: "left"
                text_size: self.size

            AnchorLayout:
                size_hint_y: None
                height: "36dp" if not root.is_login_mode else "0dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                    Color:
                        rgba: app.divider_color
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                        width: 1.0

                TextInput:
                    id: field_auth_name
                    hint_text: "Tu nombre o apodo"
                    multiline: False
                    font_size: "13.5sp"
                    padding: ["10dp", "8dp", "10dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color

        # Campo: Correo Electrónico
        CustomInputField:
            id: field_auth_email
            label_text: "CORREO ELECTRÓNICO"
            hint_text: "usuario@ejemplo.com"

        # Campo: Contraseña
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "56dp"
            spacing: "4dp"

            Label:
                text: "CONTRASEÑA"
                font_size: "11sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp"
                halign: "left"
                text_size: self.size

            AnchorLayout:
                size_hint_y: None
                height: "36dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                    Color:
                        rgba: app.divider_color
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                        width: 1.0

                TextInput:
                    id: field_auth_password
                    hint_text: "Mínimo 4 caracteres"
                    password: True
                    multiline: False
                    font_size: "13.5sp"
                    padding: ["10dp", "8dp", "10dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color

        # Etiqueta de Notificaciones / Errores
        Label:
            id: label_auth_msg
            text: root.message_text
            font_size: "11sp"
            color: [0.85, 0.20, 0.25, 1.0] if root.is_error_message else app.accent_green_color
            size_hint_y: None
            height: "36dp" if root.message_text else "10dp"
            halign: "center"
            valign: "middle"
            text_size: self.width, None

        # Botón Principal de Acción
        Button:
            size_hint_y: None
            height: "44dp"
            text: "Entrar a mi Cuenta" if root.is_login_mode else "Crear mi Cuenta"
            font_size: "14sp"
            bold: True
            color: [1, 1, 1, 1]
            background_color: [0, 0, 0, 0]
            on_release: root.submit()
            canvas.before:
                Color:
                    rgba: app.accent_green_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14, 14, 14, 14]

        # Botón de demostración rápida
        Button:
            size_hint_y: None
            height: "30dp"
            text: "Usar cuenta demo (Sofía Martínez)"
            font_size: "11sp"
            color: app.category_tag_color
            background_color: [0, 0, 0, 0]
            on_release: root.fill_demo()

        # Botón para cerrar (solo disponible si el usuario ya inició sesión previamente)
        Button:
            size_hint_y: None
            height: "28dp" if root.can_cancel else "0dp"
            opacity: 1 if root.can_cancel else 0
            disabled: not root.can_cancel
            text: "Cerrar"
            font_size: "12sp"
            color: app.text_secondary_color
            background_color: [0, 0, 0, 0]
            on_release: root.dismiss()


# --------------------------------------------------------
# 5. Modal: Finalizar Compra (Carrito -> Despensa + Historial)
# --------------------------------------------------------
<CheckoutRow>:
    size_hint_y: None
    height: "52dp"
    spacing: "8dp"
    padding: ["10dp", "6dp", "6dp", "6dp"]
    canvas.before:
        Color:
            rgba: app.sage_container_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12, 12, 12, 12]

    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.title
            font_size: "13.5sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "bottom"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        Label:
            text: "Nuevo en la despensa" if root.is_new else "Se suma a tu stock"
            font_size: "10.5sp"
            color: app.accent_green_color if root.is_new else app.text_secondary_color
            halign: "left"
            valign: "top"
            text_size: self.size

    # Cantidad comprada
    AnchorLayout:
        size_hint_x: None
        width: "58dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [8, 8, 8, 8]
        TextInput:
            id: qty_input
            text: "1"
            input_filter: numeric_input_filter
            multiline: False
            halign: "center"
            font_size: "13.5sp"
            padding: ["4dp", "10dp", "4dp", "6dp"]
            background_color: [0, 0, 0, 0]
            cursor_color: app.accent_green_color
            foreground_color: app.input_text_color

    # Unidad: elegible si es nuevo, fija si ya existe en la despensa
    Button:
        text: root.unit
        size_hint_x: None
        width: "64dp"
        font_size: "12.5sp"
        bold: root.is_new
        color: app.accent_green_color if root.is_new else app.text_secondary_color
        background_color: [0, 0, 0, 0]
        disabled: not root.is_new
        disabled_color: app.text_secondary_color
        on_release: root.open_unit_menu(self)
        canvas.before:
            Color:
                rgba: app.card_white_color if root.is_new else (0, 0, 0, 0)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [8, 8, 8, 8]

<CheckoutModal>:
    height: min(dp(600), dp(214) + dp(58) * root.row_count + (dp(44) if root.error_text else 0))

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        Label:
            text: "Finalizar compra"
            font_size: "17sp"
            bold: True
            color: app.text_primary_color
            size_hint_y: None
            height: "26dp"
            halign: "left"
            text_size: self.size

        Label:
            text: "Indica cuánto compraste de cada producto. Se sumará a tu despensa y quedará en tu historial."
            font_size: "12sp"
            color: app.text_secondary_color
            size_hint_y: None
            height: self.texture_size[1]
            halign: "left"
            text_size: self.width, None

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: rows_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "6dp"

        BoxLayout:
            size_hint_y: None
            height: "24dp"
            Label:
                text: "Total de la compra"
                font_size: "12.5sp"
                color: app.text_secondary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                text: root.total_str
                font_size: "16sp"
                bold: True
                color: app.text_primary_color
                halign: "right"
                valign: "middle"
                text_size: self.size

        FormMessageLabel:
            text: root.error_text

        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13.5sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: "Confirmar compra"
                font_size: "13.5sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_green_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 6. Modal: Alertas de la Despensa (campana de Inicio)
# --------------------------------------------------------
<AlertRow>:
    size_hint_y: None
    height: "52dp"
    spacing: "10dp"
    padding: ["10dp", "6dp", "10dp", "6dp"]
    opacity: 0.75 if self.state == "down" else 1
    canvas.before:
        Color:
            rgba: app.sage_container_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12, 12, 12, 12]

    Widget:
        size_hint: None, None
        size: "10dp", "10dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: root.alert_color
            Ellipse:
                pos: self.pos
                size: self.size

    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.alert_title
            font_size: "13.5sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "bottom"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        Label:
            text: root.alert_desc
            font_size: "11sp"
            color: root.alert_color
            halign: "left"
            valign: "top"
            text_size: self.size

    MDIcon:
        icon: "chevron-right"
        theme_text_color: "Custom"
        text_color: app.text_secondary_color
        size_hint_x: None
        width: "20dp"
        pos_hint: {"center_y": 0.5}

<AlertsModal>:
    height: min(dp(560), dp(150) + dp(58) * max(1, root.alert_count) + (dp(90) if not root.alert_count else 0))

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 24, 24]

        Label:
            text: f"Alertas ({root.alert_count})" if root.alert_count else "Alertas"
            font_size: "17sp"
            bold: True
            color: app.text_primary_color
            size_hint_y: None
            height: "26dp"
            halign: "left"
            text_size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: alerts_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "6dp"

        Button:
            size_hint_y: None
            height: "40dp"
            text: "Cerrar"
            font_size: "13sp"
            bold: True
            color: app.text_primary_color
            background_color: [0, 0, 0, 0]
            on_release: root.dismiss()
            canvas.before:
                Color:
                    rgba: app.sage_container_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
