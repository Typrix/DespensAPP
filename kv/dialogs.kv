# -*- coding: utf-8 -*-
# ========================================================
# Diálogos y Modales Visuales para DespensAPP
# ========================================================
#:import Window kivy.core.window.Window
#:import numeric_input_filter controllers.validators.numeric_input_filter

<BaseFormModal>:
    # Hoja inferior: todo el ancho en celular, máximo 560dp en pantallas anchas
    size_hint: None, None
    width: min(Window.width, dp(560))
    background_color: [0, 0, 0, 0]
    overlay_color: [0, 0, 0, 0.40]
    background: ""
    auto_dismiss: True
    _anim_duration: 0.18
    # Barrita para arrastrar la hoja hacia abajo
    canvas.after:
        Color:
            rgba: app.divider_color if self.as_sheet else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.center_x - dp(18), self.top - dp(12)
            size: dp(36), dp(4)
            radius: [2, 2, 2, 2]

# Mensaje de validación del formulario (rojo = error, ámbar = aviso).
# Ocupa espacio solo cuando hay texto.
<FormMessageLabel@Label>:
    is_warning: False
    font_size: "12sp"
    bold: True
    color: app.legible([0.82, 0.48, 0.12, 1.0] if self.is_warning else [0.85, 0.20, 0.25, 1.0], app.modo_oscuro)
    size_hint_y: None
    height: (self.texture_size[1] + dp(6)) if self.text else 0
    opacity: 1 if self.text else 0
    halign: "center"
    valign: "middle"
    text_size: self.width, None

<CustomInputField@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: "56dp"
    spacing: "4dp"
    label_text: ""
    hint_text: ""
    input_text: ""
    input_filter: None

    Label:
        text: root.label_text
        font_size: "12.5sp"
        bold: True
        color: app.text_secondary_color
        size_hint_y: None
        height: "16dp"
        halign: "left"
        text_size: self.size

    AnchorLayout:
        size_hint_y: None
        height: "36dp"
        canvas.before:
            Color:
                rgba: app.sage_container_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10, 10, 10, 10]
            Color:
                rgba: app.divider_color
            Line:
                rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                width: 1.0

        TextInput:
            id: text_input
            text: root.input_text
            hint_text: root.hint_text
            input_filter: root.input_filter
            multiline: False
            font_size: "13.5sp"
            padding: ["10dp", "8dp", "10dp", "8dp"]
            background_color: [0, 0, 0, 0]
            cursor_color: app.accent_green_color
            foreground_color: app.input_text_color
            hint_text_color: app.input_placeholder_color


# Campo de selección (menú desplegable): todo el recuadro es tocable.
# Uso: DropdownField(label_text, value, icon) + on_release: root.abrir_menu(self)
<DropdownField@ButtonBehavior+BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: "56dp"
    spacing: "4dp"
    label_text: ""
    value: ""
    icon: ""

    Label:
        text: root.label_text
        font_size: "12.5sp"
        bold: True
        color: app.text_secondary_color
        size_hint_y: None
        height: "16dp"
        halign: "left"
        text_size: self.size

    BoxLayout:
        size_hint_y: None
        height: "36dp"
        padding: ["10dp", 0, "6dp", 0]
        spacing: "8dp"
        opacity: 0.75 if root.state == "down" else 1
        canvas.before:
            Color:
                rgba: app.sage_container_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10, 10, 10, 10]
            Color:
                rgba: app.divider_color
            Line:
                rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                width: 1.0
        MDIcon:
            icon: root.icon or "tag-outline"
            size_hint_x: None
            width: "20dp" if root.icon else 0
            opacity: 1 if root.icon else 0
            font_size: "18sp"
            theme_icon_color: "Custom"
            icon_color: app.accent_green_color
            pos_hint: {"center_y": 0.5}
        Label:
            text: root.value
            font_size: "13.5sp"
            color: app.input_text_color
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        MDIcon:
            icon: "menu-down"
            size_hint_x: None
            width: "24dp"
            font_size: "22sp"
            theme_icon_color: "Custom"
            icon_color: app.accent_green_color
            pos_hint: {"center_y": 0.5}


# --------------------------------------------------------
# 2. Modal: Añadir a la Despensa (Con Umbrales y Fecha de Vencimiento)
# --------------------------------------------------------
<AddPantryItemModal>:
    # El alto se ajusta al contenido (con tope en el alto de la pantalla)
    height: min(content.minimum_height, Window.height - dp(24))

    BoxLayout:
        id: content
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: ["20dp", "22dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        # Encabezado
        BoxLayout:
            size_hint_y: None
            height: "32dp"
            Label:
                text: "Agregar a la despensa"
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size

        # Campo: Nombre del producto
        CustomInputField:
            id: field_name
            label_text: "Nombre del producto"
            hint_text: "Ej: Leche descremada, Arroz, Sal..."

        # Medida y cantidad (selector compacto)
        QuantityPicker:
            id: picker
            quantity: 1

        # Fila: Umbral mínimo (alerta) y Categoría
        BoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "10dp"

            CustomInputField:
                id: field_threshold
                label_text: "Avisar si baja de"
                hint_text: "Ej: 2"
                input_filter: numeric_input_filter

            DropdownField:
                id: field_category
                label_text: "Categoría"
                value: root.selected_category
                icon: root.selected_category_icon
                on_release: root.open_category_menu(self)

        # Campo: Fecha de Vencimiento mediante selector de calendario obligatorio
        DropdownField:
            id: field_expiration_picker
            label_text: "Fecha de vencimiento"
            value: "No vence (no perecible)" if root.has_no_expiration else (root.expiration_date_str or "Seleccionar en el calendario")
            icon: "infinity" if root.has_no_expiration else "calendar-month-outline"
            disabled: root.has_no_expiration
            opacity: 0.65 if root.has_no_expiration else 1
            on_release: root.open_date_picker()

        # Botón / Toggle: Sin fecha de vencimiento
        BoxLayout:
            size_hint_y: None
            height: "32dp"

            Button:
                text: "No perecible: sin fecha de vencimiento (tocar para quitar)" if root.has_no_expiration else "Marcar como 'Sin fecha de vencimiento'"
                font_size: "12.5sp"
                bold: root.has_no_expiration
                color: app.accent_green_color if root.has_no_expiration else app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.toggle_no_expiration()
                canvas.before:
                    Color:
                        rgba: [0.88, 0.96, 0.90, 1.0] if root.has_no_expiration else app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]

        # Aviso (ámbar) si el producto ya venció y error de validación (rojo)
        FormMessageLabel:
            text: root.warning_text
            is_warning: True

        FormMessageLabel:
            text: root.error_text

        # Botones de Acción
        BoxLayout:
            size_hint_y: None
            height: "52dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "15sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: "Guardar"
                font_size: "15sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_fill_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 2B. Modal: Gestionar Producto de Despensa (Stock, Vencimiento, Eliminar)
# --------------------------------------------------------
<PantryItemDetailModal>:
    # El alto se ajusta al contenido (vista o edición)
    height: content.minimum_height

    BoxLayout:
        id: content
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: ["20dp", "16dp", "20dp", "16dp"]
        spacing: "12dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        # Encabezado: ícono, nombre + estado, editar y cerrar
        BoxLayout:
            size_hint_y: None
            height: "50dp"
            spacing: "12dp"

            ProductBadge:
                icon: root.item_icon
                tint: root.tint_dark if app.modo_oscuro else root.tint_light
                badge_size: dp(46)
                radius: 14
                pos_hint: {"center_y": 0.5}

            BoxLayout:
                orientation: "vertical"
                spacing: "4dp"
                Label:
                    text: root.item_name
                    font_size: "18sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    shorten: True
                    shorten_from: "right"
                BoxLayout:
                    size_hint_y: None
                    height: "20dp"
                    spacing: "8dp"
                    Label:
                        text: root.status_str
                        font_size: "12.5sp"
                        bold: True
                        color: app.legible(root.status_text_color, app.modo_oscuro)
                        size_hint: None, None
                        size: self.texture_size[0] + dp(16), dp(20)
                        canvas.before:
                            Color:
                                rgba: root.status_color[:3] + [0.22 if app.modo_oscuro else 0.14]
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10, 10, 10, 10]
                    Label:
                        text: root.item_category
                        font_size: "12.5sp"
                        color: app.text_secondary_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        shorten: True

            MDIconButton:
                icon: "pencil-outline"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: app.accent_green_color
                pos_hint: {"center_y": 0.5}
                opacity: 0 if root.is_editing else 1
                disabled: root.is_editing
                on_release: root.start_edit()

            MDIconButton:
                icon: "close"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()

        # Cuerpo: se intercambia entre vista (view_box) y edición (edit_box)
        BoxLayout:
            id: body
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height

            # ================= VISTA =================
            BoxLayout:
                id: view_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"

                # Tarjeta de stock
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["12dp", "10dp", "12dp", "10dp"]
                    spacing: "8dp"
                    canvas.before:
                        Color:
                            rgba: app.sage_container_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [16, 16, 16, 16]

                    # Stock: cantidad con − y + (se puede escribir); la medida se cambia al editar
                    QuantityPicker:
                        id: stock_picker
                        show_units: False
                        quantity_label: "Stock actual"
                        on_change: root.on_picker_change(args[1])

                    # Mínimo que dispara la alerta
                    BoxLayout:
                        size_hint_y: None
                        height: "18dp"
                        spacing: "6dp"
                        MDIcon:
                            icon: "bell-outline"
                            font_size: "15sp"
                            theme_icon_color: "Custom"
                            icon_color: app.text_secondary_color
                            size_hint_x: None
                            width: "16dp"
                            pos_hint: {"center_y": 0.5}
                        Label:
                            text: root.threshold_hint
                            font_size: "13sp"
                            color: app.text_secondary_color
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                # Tarjeta de vencimiento
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["12dp", "10dp", "12dp", "10dp"]
                    spacing: "10dp"
                    canvas.before:
                        Color:
                            rgba: app.sage_container_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [16, 16, 16, 16]

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "10dp"
                        AnchorLayout:
                            size_hint: None, None
                            size: "36dp", "36dp"
                            pos_hint: {"center_y": 0.5}
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]
                            MDIcon:
                                icon: "calendar-clock-outline" if root.has_expiration else "infinity"
                                font_size: "19sp"
                                theme_icon_color: "Custom"
                                icon_color: app.legible(root.exp_color, app.modo_oscuro)
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: root.exp_title
                                font_size: "13.5sp"
                                bold: True
                                color: app.text_primary_color
                                halign: "left"
                                valign: "bottom"
                                text_size: self.size
                            Label:
                                text: root.exp_desc
                                font_size: "11.5sp"
                                bold: True
                                color: app.legible(root.exp_color, app.modo_oscuro)
                                halign: "left"
                                valign: "top"
                                text_size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        Button:
                            text: "Cambiar fecha" if root.has_expiration else "Agregar fecha"
                            font_size: "12.5sp"
                            bold: True
                            color: app.accent_green_color
                            background_color: [0, 0, 0, 0]
                            on_release: root.edit_expiration()
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]

                        Button:
                            text: "No vence"
                            font_size: "12.5sp"
                            color: app.text_secondary_color
                            background_color: [0, 0, 0, 0]
                            size_hint_x: 1 if root.has_expiration else 0.001
                            opacity: 1 if root.has_expiration else 0
                            disabled: not root.has_expiration
                            on_release: root.clear_expiration()
                            canvas.before:
                                Color:
                                    rgba: app.card_white_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10, 10, 10, 10]

                # Reponer: solo si el stock está bajo o agotado
                Button:
                    text: root.restock_text
                    font_size: "13sp"
                    bold: True
                    size_hint_y: None
                    height: "44dp" if root.needs_restock else 0
                    opacity: 1 if root.needs_restock else 0
                    disabled: not root.needs_restock or root.restock_text != "Añadir a una lista"
                    disabled_color: app.text_secondary_color
                    color: app.accent_green_color
                    background_color: [0, 0, 0, 0]
                    on_release: root.add_to_list(self)
                    canvas.before:
                        Color:
                            rgba: app.active_pill_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12, 12, 12, 12]

                FormMessageLabel:
                    text: root.error_text

                Button:
                    text: "Listo"
                    font_size: "14sp"
                    bold: True
                    size_hint_y: None
                    height: "46dp"
                    color: [1, 1, 1, 1]
                    background_color: [0, 0, 0, 0]
                    on_release: root.dismiss()
                    canvas.before:
                        Color:
                            rgba: app.accent_fill_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14, 14, 14, 14]

                # Acción destructiva secundaria (con "Deshacer")
                Button:
                    text: "Eliminar producto"
                    font_size: "12.5sp"
                    size_hint_y: None
                    height: "30dp"
                    color: [0.85, 0.25, 0.25, 1.0]
                    background_color: [0, 0, 0, 0]
                    on_release: root.delete_item()

            # ================= EDICIÓN =================
            BoxLayout:
                id: edit_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"

                CustomInputField:
                    id: edit_name
                    label_text: "Nombre"
                    hint_text: "Ej: Arroz integral"

                DropdownField:
                    label_text: "Categoría"
                    value: root.edit_category
                    icon: root.edit_category_icon
                    on_release: root.open_edit_category_menu(self)

                # Medida: fila de píldoras (un., kg, g, L...)
                SmallFieldLabel:
                    text: "Medida"

                UnitChipRow:
                    unit: root.edit_unit
                    on_select: root._set_edit_unit(args[1])

                BoxLayout:
                    size_hint_y: None
                    height: "56dp"

                    CustomInputField:
                        id: edit_threshold
                        label_text: "Avisar si baja de"
                        hint_text: "Ej: 2"
                        input_filter: numeric_input_filter

                Label:
                    text: "La cantidad y la fecha de vencimiento no cambian al editar."
                    font_size: "12.5sp"
                    color: app.text_secondary_color
                    size_hint_y: None
                    height: self.texture_size[1] + dp(2)
                    text_size: self.width, None
                    halign: "left"

                FormMessageLabel:
                    text: root.error_text

                BoxLayout:
                    size_hint_y: None
                    height: "44dp"
                    spacing: "10dp"

                    Button:
                        text: "Cancelar"
                        font_size: "13.5sp"
                        color: app.text_secondary_color
                        background_color: [0, 0, 0, 0]
                        on_release: root.cancel_edit()
                        canvas.before:
                            Color:
                                rgba: app.sage_container_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14, 14, 14, 14]

                    Button:
                        text: "Guardar cambios"
                        font_size: "13.5sp"
                        bold: True
                        color: [1, 1, 1, 1]
                        background_color: [0, 0, 0, 0]
                        on_release: root.save_edit()
                        canvas.before:
                            Color:
                                rgba: app.accent_fill_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 2C. Modal: Edición Genérica de Texto (Nombre o Fecha)
# --------------------------------------------------------
<EditItemModal>:
    height: "270dp" if root.error_text else "230dp"

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "12dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        Label:
            text: root.title_text
            font_size: "14.5sp"
            bold: True
            color: app.text_primary_color
            size_hint_y: None
            height: "26dp"
            halign: "left"
            text_size: self.size

        CustomInputField:
            id: field_edit
            label_text: "Nuevo valor"
            hint_text: "Escribe aquí..."

        Widget:
            size_hint_y: 1

        FormMessageLabel:
            text: root.error_text

        BoxLayout:
            size_hint_y: None
            height: "40dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

            Button:
                text: "Guardar"
                font_size: "13sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_fill_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]


# --------------------------------------------------------
# 3. Modal: Nueva Lista de Compras
# --------------------------------------------------------
<AddShoppingListModal>:
    height: "474dp" if root.error_text else "430dp"

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        # Encabezado
        BoxLayout:
            size_hint_y: None
            height: "30dp"
            Label:
                text: "Nueva Lista de Compras"
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size

        # Campo: Nombre de la lista
        CustomInputField:
            id: field_name
            label_text: "Nombre de la lista"
            hint_text: "Ej: Supermercado Lunes, Asado, Verdulería..."

        # Selector de Supermercado
        DropdownField:
            id: field_supermarket
            label_text: "Supermercado"
            value: root.selected_supermarket
            icon: "storefront-outline"
            on_release: root.open_supermarket_menu(self)

        # Selector de Color para el Icono
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "60dp"
            spacing: "6dp"

            Label:
                text: "Color del icono"
                font_size: "12.5sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp"
                halign: "left"
                text_size: self.size

            BoxLayout:
                id: color_chips_box
                size_hint_y: None
                height: "36dp"
                spacing: "10dp"

        Widget:
            size_hint_y: 1

        FormMessageLabel:
            text: root.error_text

        # Botones de Acción
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13.5sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: "Crear Lista"
                font_size: "13.5sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_fill_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 3B. Producto de una Lista (tachar = ya está en el carro)
# --------------------------------------------------------
<ShoppingListItemRow>:
    size_hint_y: None
    height: "56dp"
    spacing: "3dp"
    padding: ["10dp", "4dp", "4dp", "4dp"]
    canvas.before:
        Color:
            # En modo oscuro usa sage_container_color (tono azul medianoche #1D293D)
            # En modo claro usa el gris claro sutil original
            rgba: (app.sage_container_color if not root.is_checked else [0.15, 0.22, 0.32, 0.7]) if app.modo_oscuro else ([0.95, 0.96, 0.95, 1.0] if not root.is_checked else [0.91, 0.92, 0.91, 0.7])
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

    # Check circular (icono Material: Roboto no trae el glifo ✓)
    TapArea:
        size_hint: None, None
        size: "28dp", "28dp"
        pos_hint: {"center_y": 0.5}
        on_release: root.toggle()
        canvas.before:
            Color:
                rgba: app.accent_fill_color if root.is_checked else ([0.30, 0.40, 0.55, 1.0] if app.modo_oscuro else [0.75, 0.78, 0.76, 1.0])
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [14, 14, 14, 14]
        AnchorLayout:
            MDIcon:
                icon: "check"
                font_size: "18sp"
                theme_icon_color: "Custom"
                icon_color: [1, 1, 1, 1]
                opacity: 1 if root.is_checked else 0
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

    # Nombre y precio (tocar para editar)
    TapArea:
        size_hint_x: 1
        spacing: "4dp"
        on_release: root.edit()
        MDIcon:
            icon: root.icon
            size_hint_x: None
            width: "20dp"
            font_size: "18sp"
            theme_icon_color: "Custom"
            icon_color: app.text_secondary_color if root.is_checked else (root.tint_dark if app.modo_oscuro else root.tint_light)
            opacity: 0.6 if root.is_checked else 1
            pos_hint: {"center_y": 0.5}
        Label:
            text: f"[s]{root.name}[/s]" if root.is_checked else root.name
            markup: True
            font_size: "13.5sp"
            color: app.text_secondary_color if root.is_checked else app.text_primary_color
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        Label:
            text: root.price_str or "Editar $"
            size_hint_x: None
            width: "56dp"
            font_size: "12.5sp" if root.price_str else "11sp"
            bold: bool(root.price_str)
            color: (app.text_secondary_color if root.is_checked else app.text_primary_color) if root.price_str else app.accent_green_color
            halign: "right"
            valign: "middle"
            text_size: self.size

    # Cantidad: − y +; tocar la etiqueta abre la hoja para escribirla
    BoxLayout:
        size_hint: None, None
        width: "106dp"
        height: "36dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: app.sage_container_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [18, 18, 18, 18]
        StockStepButton:
            text: "-"
            width: "32dp"
            color: app.text_primary_color
            disabled_color: app.text_secondary_color
            opacity: 0.35 if self.disabled else (0.6 if self.state == "down" else 1)
            disabled: root.quantity <= root.min_quantity
            on_release: root.adjust_quantity(-1)
        TapLabel:
            text: root.quantity_label
            font_size: "12sp"
            bold: True
            color: app.text_primary_color
            halign: "center"
            valign: "middle"
            text_size: self.size
            shorten: True
            on_release: root.open_quantity()
        StockStepButton:
            text: "+"
            width: "32dp"
            color: app.text_primary_color
            on_release: root.adjust_quantity(1)

    # Eliminar producto (con "Deshacer")
    MDIconButton:
        icon: "close"
        style: "standard"
        size_hint_x: None
        width: "30dp"
        theme_icon_color: "Custom"
        icon_color: [0.85, 0.25, 0.25, 0.85]
        pos_hint: {"center_y": 0.5}
        on_release: root.delete()


# --------------------------------------------------------
# 3C. Modal: Lista de Compras = Carrito (anotar, tachar, finalizar)
# --------------------------------------------------------
<ShoppingListDetailModal>:
    height: min(Window.height - dp(24), dp(650))

    BoxLayout:
        orientation: "vertical"
        padding: ["18dp", "16dp", "18dp", "16dp"]
        spacing: "8dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        # Cabecera de la Lista
        BoxLayout:
            size_hint_y: None
            height: "36dp"
            spacing: "8dp"

            Widget:
                size_hint: None, None
                size: "14dp", "14dp"
                pos_hint: {"center_y": 0.5}
                canvas.before:
                    Color:
                        rgba: root.icon_color_rgba
                    Ellipse:
                        pos: self.pos
                        size: self.size

            Label:
                text: root.list_name
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
                shorten: True
                shorten_from: "right"

            MDIconButton:
                icon: "pencil-outline"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}
                on_release: root.edit_list_name()

            MDIconButton:
                icon: "trash-can-outline"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: [0.85, 0.25, 0.25, 0.9]
                pos_hint: {"center_y": 0.5}
                on_release: root.delete_this_list()

        Label:
            text: root.subtitle_info
            font_size: "12sp"
            color: app.text_secondary_color
            size_hint_y: None
            height: "18dp"
            halign: "left"
            text_size: self.size

        # Fila 1: Anotar producto con precio unitario
        BoxLayout:
            size_hint_y: None
            height: "40dp"
            spacing: "6dp"

            AnchorLayout:
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]
                TextInput:
                    id: new_item_input
                    hint_text: "Anotar producto..."
                    multiline: False
                    write_tab: False
                    font_size: "13sp"
                    padding: ["10dp", "10dp", "8dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color
                    on_text_validate: root.add_item()

            AnchorLayout:
                size_hint_x: None
                width: "92dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]
                TextInput:
                    id: new_item_price
                    hint_text: "$ precio"
                    input_filter: numeric_input_filter
                    multiline: False
                    write_tab: False
                    font_size: "13sp"
                    padding: ["8dp", "10dp", "6dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color
                    on_text_validate: root.add_item()

        # Fila 2: Cantidad, Medida y botón Añadir
        BoxLayout:
            size_hint_y: None
            height: "38dp"
            spacing: "6dp"

            Label:
                text: "Cantidad y medida:"
                size_hint_x: None
                width: "108dp"
                font_size: "11.5sp"
                color: app.text_secondary_color
                halign: "left"
                valign: "middle"
                text_size: self.size

            AnchorLayout:
                size_hint_x: None
                width: "62dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                TextInput:
                    id: new_item_qty
                    text: "1"
                    hint_text: "Cant."
                    input_filter: numeric_input_filter
                    multiline: False
                    write_tab: False
                    halign: "center"
                    font_size: "13sp"
                    padding: ["6dp", "9dp", "6dp", "6dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color
                    on_text_validate: root.add_item()

            Button:
                text: root.selected_new_unit
                size_hint_x: None
                width: "66dp"
                font_size: "12.5sp"
                bold: True
                color: app.accent_green_color
                background_color: [0, 0, 0, 0]
                on_release: root.open_new_unit_menu(self)
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]

            Button:
                text: "+ Añadir"
                font_size: "12.5sp"
                bold: True
                size_hint_x: 1
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.add_item()
                canvas.before:
                    Color:
                        rgba: app.accent_fill_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]

        FormMessageLabel:
            text: root.error_text

        # Productos (orden fijo)
        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False

            BoxLayout:
                id: items_list_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "6dp"

        # Total: parte en $0 y sube al tachar
        BoxLayout:
            size_hint_y: None
            height: "46dp"
            padding: ["12dp", "4dp", "12dp", "4dp"]
            canvas.before:
                Color:
                    rgba: app.sage_container_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
            BoxLayout:
                orientation: "vertical"
                Label:
                    text: "En el carro"
                    font_size: "12.5sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size
                Label:
                    text: root.progress_str
                    font_size: "12sp"
                    color: app.text_secondary_color
                    halign: "left"
                    valign: "top"
                    text_size: self.size
            Label:
                text: root.in_cart_str
                font_size: "21sp"
                bold: True
                color: app.text_primary_color
                halign: "right"
                valign: "middle"
                text_size: self.size

        # Pie: Cerrar + Finalizar compra (solo si hay algo en el carro)
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cerrar"
                font_size: "13sp"
                bold: True
                color: app.text_primary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

            Button:
                text: f"Finalizar compra ({root.checked_count})"
                font_size: "13sp"
                bold: True
                size_hint_x: 1.6 if root.checked_count else 0.001
                opacity: 1 if root.checked_count else 0
                disabled: not root.checked_count
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.finalize()
                canvas.before:
                    Color:
                        rgba: app.accent_fill_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]


# --------------------------------------------------------
# 3D. Modal: Editar Producto de Lista (nombre, precio, cantidad y medida)
# --------------------------------------------------------
<EditListItemModal>:
    height: "355dp" if root.error_text else "315dp"

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        Label:
            text: "Editar producto"
            font_size: "17sp"
            bold: True
            color: app.text_primary_color
            size_hint_y: None
            height: "26dp"
            halign: "left"
            text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "10dp"
            CustomInputField:
                id: field_name
                label_text: "Producto"
                hint_text: "Ej: Huevos"
            CustomInputField:
                id: field_price
                size_hint_x: None
                width: "110dp"
                label_text: "PRECIO ($)"
                hint_text: "Ej: 1.990"
                input_filter: numeric_input_filter

        BoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "10dp"
            CustomInputField:
                id: field_qty
                label_text: "CANTIDAD"
                hint_text: "Ej: 2"
                input_filter: numeric_input_filter
            BoxLayout:
                orientation: "vertical"
                size_hint_x: None
                width: "110dp"
                spacing: "4dp"
                Label:
                    text: "MEDIDA"
                    font_size: "11sp"
                    bold: True
                    color: app.text_secondary_color
                    size_hint_y: None
                    height: "16dp"
                    halign: "left"
                    text_size: self.size
                Button:
                    text: root.selected_unit
                    size_hint_y: None
                    height: "36dp"
                    font_size: "13sp"
                    bold: True
                    color: app.accent_green_color
                    background_color: [0, 0, 0, 0]
                    on_release: root.open_unit_menu(self)
                    canvas.before:
                        Color:
                            rgba: app.sage_container_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10, 10, 10, 10]

        Widget:
            size_hint_y: 1

        FormMessageLabel:
            text: root.error_text

        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13.5sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: "Guardar"
                font_size: "13.5sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_fill_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 4. Modal: Cuenta de Usuario (Inicio de Sesión, Registro y Edición)
# --------------------------------------------------------
<AuthModal>:
    height: "510dp" if root.is_edit_profile_mode else "505dp"
    auto_dismiss: root.can_cancel

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        # Encabezado con Título
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "46dp" if root.is_edit_profile_mode else "28dp"
            spacing: "2dp"
            Label:
                text: "Cuenta de usuario" if root.is_edit_profile_mode else "Bienvenido/a a DespensAPP"
                font_size: "17sp" if root.is_edit_profile_mode else "16.5sp"
                bold: True
                color: app.text_primary_color
                halign: "left" if root.is_edit_profile_mode else "center"
                valign: "middle"
                text_size: self.size
            Label:
                text: "Actualiza tu nombre, correo o contraseña." if root.is_edit_profile_mode else ""
                font_size: "11.5sp"
                color: app.text_secondary_color
                size_hint_y: None
                height: "18dp" if root.is_edit_profile_mode else "0dp"
                opacity: 1 if root.is_edit_profile_mode else 0
                halign: "left"
                valign: "middle"
                text_size: self.size

        # Selector de Pestaña: Iniciar Sesión / Crear Cuenta (oculto en modo edición de cuenta)
        BoxLayout:
            size_hint_y: None
            height: "0dp" if root.is_edit_profile_mode else "38dp"
            opacity: 0 if root.is_edit_profile_mode else 1
            disabled: root.is_edit_profile_mode
            spacing: "6dp"
            canvas.before:
                Color:
                    rgba: [0, 0, 0, 0] if root.is_edit_profile_mode else app.sage_container_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14, 14, 14, 14]

            Button:
                id: btn_tab_login
                text: "Iniciar Sesión"
                bold: True
                font_size: "12.5sp"
                color: app.accent_green_color if root.is_login_mode else app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.set_mode(True)
                canvas.before:
                    Color:
                        rgba: (app.card_white_color if root.is_login_mode else [0, 0, 0, 0]) if not root.is_edit_profile_mode else [0, 0, 0, 0]
                    RoundedRectangle:
                        pos: [self.x + 3, self.y + 3]
                        size: [self.width - 6, self.height - 6]
                        radius: [12, 12, 12, 12]

            Button:
                id: btn_tab_register
                text: "Crear Cuenta"
                bold: True
                font_size: "12.5sp"
                color: app.accent_green_color if not root.is_login_mode else app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.set_mode(False)
                canvas.before:
                    Color:
                        rgba: (app.card_white_color if not root.is_login_mode else [0, 0, 0, 0]) if not root.is_edit_profile_mode else [0, 0, 0, 0]
                    RoundedRectangle:
                        pos: [self.x + 3, self.y + 3]
                        size: [self.width - 6, self.height - 6]
                        radius: [12, 12, 12, 12]

        # Campo: Nombre (En modo registro o en modo edición de cuenta)
        BoxLayout:
            id: box_name
            orientation: "vertical"
            size_hint_y: None
            height: "56dp" if (not root.is_login_mode or root.is_edit_profile_mode) else "0dp"
            opacity: 1 if (not root.is_login_mode or root.is_edit_profile_mode) else 0
            disabled: root.is_login_mode and not root.is_edit_profile_mode

            Label:
                text: "Nombre completo"
                font_size: "12.5sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp" if (not root.is_login_mode or root.is_edit_profile_mode) else "0dp"
                halign: "left"
                text_size: self.size

            AnchorLayout:
                size_hint_y: None
                height: "36dp" if (not root.is_login_mode or root.is_edit_profile_mode) else "0dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                    Color:
                        rgba: app.divider_color
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                        width: 1.0

                TextInput:
                    id: field_auth_name
                    hint_text: "Tu nombre o apodo"
                    multiline: False
                    font_size: "13.5sp"
                    padding: ["10dp", "8dp", "10dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color

        # Campo: Correo Electrónico
        CustomInputField:
            id: field_auth_email
            label_text: "Correo electrónico"
            hint_text: "usuario@ejemplo.com"

        # Campo: Contraseña
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "56dp"
            spacing: "4dp"

            Label:
                text: "Nueva contraseña (opcional)" if root.is_edit_profile_mode else "Contraseña"
                font_size: "12.5sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp"
                halign: "left"
                text_size: self.size

            AnchorLayout:
                size_hint_y: None
                height: "36dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                    Color:
                        rgba: app.divider_color
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                        width: 1.0

                TextInput:
                    id: field_auth_password
                    hint_text: "Sin cambios (mínimo 4 caracteres)" if root.is_edit_profile_mode else "Mínimo 4 caracteres"
                    password: True
                    multiline: False
                    font_size: "13.5sp"
                    padding: ["10dp", "8dp", "10dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color

        # Campo: Confirmar Contraseña (en modo edición de cuenta)
        BoxLayout:
            id: box_password_confirm
            orientation: "vertical"
            size_hint_y: None
            height: "56dp" if root.is_edit_profile_mode else "0dp"
            opacity: 1 if root.is_edit_profile_mode else 0
            disabled: not root.is_edit_profile_mode
            spacing: "4dp" if root.is_edit_profile_mode else "0dp"

            Label:
                text: "Confirmar nueva contraseña"
                font_size: "12.5sp"
                bold: True
                color: app.text_secondary_color
                size_hint_y: None
                height: "16dp" if root.is_edit_profile_mode else "0dp"
                halign: "left"
                text_size: self.size

            AnchorLayout:
                size_hint_y: None
                height: "36dp" if root.is_edit_profile_mode else "0dp"
                canvas.before:
                    Color:
                        rgba: app.sage_container_color if root.is_edit_profile_mode else [0, 0, 0, 0]
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                    Color:
                        rgba: app.divider_color if root.is_edit_profile_mode else [0, 0, 0, 0]
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                        width: 1.0

                TextInput:
                    id: field_auth_password_confirm
                    hint_text: "Repite la nueva contraseña"
                    password: True
                    multiline: False
                    font_size: "13.5sp"
                    padding: ["10dp", "8dp", "10dp", "8dp"]
                    background_color: [0, 0, 0, 0]
                    cursor_color: app.accent_green_color
                    foreground_color: app.input_text_color
                    hint_text_color: app.input_placeholder_color

        # Etiqueta de Notificaciones / Errores
        Label:
            id: label_auth_msg
            text: root.message_text
            font_size: "12.5sp"
            color: app.legible([0.85, 0.20, 0.25, 1.0], app.modo_oscuro) if root.is_error_message else app.accent_green_color
            size_hint_y: None
            height: "36dp" if root.message_text else "10dp"
            halign: "center"
            valign: "middle"
            text_size: self.width, None

        # Botón Principal de Acción
        Button:
            size_hint_y: None
            height: "44dp"
            text: "Guardar cambios" if root.is_edit_profile_mode else ("Entrar a mi Cuenta" if root.is_login_mode else "Crear mi Cuenta")
            font_size: "14sp"
            bold: True
            disabled: not root.can_submit if root.is_edit_profile_mode else False
            disabled_color: [1, 1, 1, 0.65]
            color: [1, 1, 1, 1]
            background_color: [0, 0, 0, 0]
            on_release: root.submit()
            canvas.before:
                Color:
                    rgba: (app.accent_fill_color[:3] + [0.38]) if (root.is_edit_profile_mode and not root.can_submit) else app.accent_fill_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14, 14, 14, 14]

        # Botón para cerrar (solo disponible si el usuario ya inició sesión previamente)
        Button:
            size_hint_y: None
            height: "28dp" if root.can_cancel else "0dp"
            opacity: 1 if root.can_cancel else 0
            disabled: not root.can_cancel
            text: "Cancelar" if root.is_edit_profile_mode else "Cerrar"
            font_size: "12sp"
            color: app.text_secondary_color
            background_color: [0, 0, 0, 0]
            on_release: root.dismiss()


# --------------------------------------------------------
# 5. Modal: Finalizar Compra (Resumen y Confirmación)
# --------------------------------------------------------
<CheckoutRow>:
    size_hint_y: None
    height: "60dp"
    spacing: "8dp"
    padding: ["12dp", "8dp", "8dp", "8dp"]
    canvas.before:
        Color:
            rgba: app.sage_container_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14, 14, 14, 14]

    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        Label:
            text: root.title
            font_size: "14.5sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "bottom"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        Label:
            text: root.detail_str
            font_size: "11sp"
            color: app.accent_green_color if root.is_new else app.text_secondary_color
            halign: "left"
            valign: "top"
            text_size: self.size
            shorten: True
            shorten_from: "right"

    # Cantidad y medida anotadas en la lista (solo lectura: se corrige en la lista)
    Label:
        text: root.amount_str
        size_hint_x: None
        width: max(dp(56), self.texture_size[0])
        font_size: "14sp"
        bold: True
        color: app.text_primary_color
        halign: "right"
        valign: "middle"
        text_size: None, self.height

    # Subtotal de la fila
    Label:
        text: root.subtotal_str
        size_hint_x: None
        width: "64dp"
        font_size: "13sp"
        bold: True
        color: app.text_primary_color
        halign: "right"
        valign: "middle"
        text_size: self.size

<CheckoutModal>:
    height: min(Window.height - dp(24), dp(236) + dp(66) * root.row_count + (dp(44) if root.error_text else 0))

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        Label:
            text: "Resumen de la compra"
            font_size: "17sp"
            bold: True
            color: app.text_primary_color
            size_hint_y: None
            height: "24dp"
            halign: "left"
            text_size: self.size

        Label:
            text: f"{root.summary_subtitle} · Para cambiar una cantidad, edítala en la lista."
            font_size: "11.5sp"
            color: app.text_secondary_color
            size_hint_y: None
            height: self.texture_size[1]
            halign: "left"
            text_size: self.width, None

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: rows_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "6dp"

        BoxLayout:
            size_hint_y: None
            height: "24dp"
            Label:
                text: "Total de la compra"
                font_size: "12.5sp"
                color: app.text_secondary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                text: root.total_str
                font_size: "16sp"
                bold: True
                color: app.text_primary_color
                halign: "right"
                valign: "middle"
                text_size: self.size

        FormMessageLabel:
            text: root.error_text

        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "10dp"

            Button:
                text: "Cancelar"
                font_size: "13.5sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]

            Button:
                text: "Confirmar compra"
                font_size: "13.5sp"
                bold: True
                color: [1, 1, 1, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.submit()
                canvas.before:
                    Color:
                        rgba: app.accent_fill_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]


# --------------------------------------------------------
# 6. Modal: Alertas de la Despensa (campana de Inicio)
# --------------------------------------------------------
<AlertRow>:
    size_hint_y: None
    height: "52dp"
    spacing: "10dp"
    padding: ["10dp", "6dp", "10dp", "6dp"]
    opacity: 0.75 if self.state == "down" else 1
    canvas.before:
        Color:
            rgba: app.sage_container_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12, 12, 12, 12]

    Widget:
        size_hint: None, None
        size: "10dp", "10dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: root.alert_color
            Ellipse:
                pos: self.pos
                size: self.size

    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.alert_title
            font_size: "13.5sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "bottom"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        Label:
            text: root.alert_desc
            font_size: "12.5sp"
            color: app.legible(root.alert_color, app.modo_oscuro)
            halign: "left"
            valign: "top"
            text_size: self.size

    MDIcon:
        icon: "chevron-right"
        theme_icon_color: "Custom"
        icon_color: app.text_secondary_color
        size_hint_x: None
        width: "20dp"
        pos_hint: {"center_y": 0.5}

<AlertsModal>:
    height: min(dp(560), dp(150) + dp(58) * max(1, root.alert_count) + (dp(90) if not root.alert_count else 0))

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        Label:
            text: f"Alertas ({root.alert_count})" if root.alert_count else "Alertas"
            font_size: "17sp"
            bold: True
            color: app.text_primary_color
            size_hint_y: None
            height: "26dp"
            halign: "left"
            text_size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: alerts_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "6dp"

        Button:
            size_hint_y: None
            height: "40dp"
            text: "Cerrar"
            font_size: "13sp"
            bold: True
            color: app.text_primary_color
            background_color: [0, 0, 0, 0]
            on_release: root.dismiss()
            canvas.before:
                Color:
                    rgba: app.sage_container_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]

# --------------------------------------------------------
# Modal: Historial de compras del periodo (Ver todas)
# --------------------------------------------------------
<PurchaseHistoryModal>:
    # Se ajusta al contenido, con tope en el alto de la pantalla (luego hace scroll)
    height: min(Window.height - dp(72), dp(96) + history_box.height)

    BoxLayout:
        orientation: "vertical"
        padding: ["18dp", "16dp", "18dp", "16dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        BoxLayout:
            size_hint_y: None
            height: "44dp"
            BoxLayout:
                orientation: "vertical"
                Label:
                    text: root.title_text
                    font_size: "17sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: root.summary
                    font_size: "11.5sp"
                    color: app.text_secondary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    shorten: True
            MDIconButton:
                icon: "close"
                style: "standard"
                theme_icon_color: "Custom"
                icon_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()

        ScrollView:
            do_scroll_x: False
            bar_width: "3dp"
            BoxLayout:
                id: history_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "10dp"


# --------------------------------------------------------
# 8. Modal: DespensAPP Pro (Desbloqueo de Estadísticas Avanzadas)
# --------------------------------------------------------
<ProFeatureRow@BoxLayout>:
    icon_name: "check-circle-outline"
    title_text: ""
    desc_text: ""
    size_hint_y: None
    height: "44dp"
    spacing: "10dp"
    padding: ["10dp", "6dp", "10dp", "6dp"]
    canvas.before:
        Color:
            rgba: app.sage_container_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12, 12, 12, 12]

    AnchorLayout:
        size_hint: None, None
        size: "28dp", "28dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: [0.96, 0.62, 0.04, 0.18]
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [8, 8, 8, 8]
        MDIcon:
            icon: root.icon_name
            font_size: "16sp"
            theme_icon_color: "Custom"
            icon_color: [0.92, 0.58, 0.05, 1.0]
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

    BoxLayout:
        orientation: "vertical"
        pos_hint: {"center_y": 0.5}
        Label:
            text: root.title_text
            font_size: "12.5sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "bottom"
            text_size: self.size
        Label:
            text: root.desc_text
            font_size: "12sp"
            color: app.text_secondary_color
            halign: "left"
            valign: "top"
            text_size: self.size

<ProUpgradeModal>:
    height: dp(415) + (dp(28) if root.error_text else 0)

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "18dp", "20dp", "18dp"]
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        # Encabezado con insignia PRO
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "12dp"

            AnchorLayout:
                size_hint: None, None
                size: "42dp", "42dp"
                pos_hint: {"center_y": 0.5}
                canvas.before:
                    Color:
                        rgba: [0.96, 0.62, 0.04, 0.16]
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14, 14, 14, 14]
                MDIcon:
                    icon: "crown"
                    font_size: "22sp"
                    theme_icon_color: "Custom"
                    icon_color: [0.92, 0.58, 0.05, 1.0]
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

            BoxLayout:
                orientation: "vertical"
                pos_hint: {"center_y": 0.5}
                BoxLayout:
                    size_hint_y: None
                    height: "22dp"
                    spacing: "6dp"
                    Label:
                        text: "DespensAPP Pro"
                        font_size: "17sp"
                        bold: True
                        color: app.text_primary_color
                        size_hint_x: None
                        width: self.texture_size[0]
                        halign: "left"
                        valign: "middle"
                    AnchorLayout:
                        size_hint: None, None
                        size: "38dp", "18dp"
                        pos_hint: {"center_y": 0.5}
                        canvas.before:
                            Color:
                                rgba: [0.92, 0.58, 0.05, 1.0]
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [6, 6, 6, 6]
                        Label:
                            text: "PRO"
                            font_size: "12sp"
                            bold: True
                            color: [0.086, 0.149, 0.251, 1]
                Label:
                    text: "Listas y estadísticas sin límites"
                    font_size: "12.5sp"
                    color: app.text_secondary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

        Label:
            text: root.context_subtitle
            font_size: "12sp"
            color: app.text_secondary_color
            size_hint_y: None
            height: "34dp"
            halign: "left"
            valign: "middle"
            text_size: self.width, None

        # Beneficios incluidos
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "144dp"
            spacing: "6dp"

            ProFeatureRow:
                icon_name: "clipboard-list-outline"
                title_text: "Listas de compras ilimitadas"
                desc_text: "Crea más de 1 lista para organizar todas tus compras."

            ProFeatureRow:
                icon_name: "calendar-range"
                title_text: "Estadísticas de 6 meses y Año"
                desc_text: "Desbloquea el análisis semestral y anual de tus gastos."

            ProFeatureRow:
                icon_name: "shield-check-outline"
                title_text: "Activación permanente en tu cuenta"
                desc_text: "Pago único asociado a tu perfil en la base de datos."

        # Tarjeta de precio
        BoxLayout:
            size_hint_y: None
            height: "36dp"
            padding: ["12dp", "4dp", "12dp", "4dp"]
            canvas.before:
                Color:
                    rgba: app.leaf_badge_bg_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10, 10, 10, 10]
            Label:
                text: "Licencia completa DespensAPP Pro"
                font_size: "11.5sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                text: "$4.990"
                size_hint_x: None
                width: "64dp"
                font_size: "14sp"
                bold: True
                color: app.accent_green_color
                halign: "right"
                valign: "middle"
                text_size: self.size

        FormMessageLabel:
            text: root.error_text

        # Botones de acción
        BoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "10dp"

            Button:
                text: "Más tarde"
                size_hint_x: 0.42
                font_size: "13sp"
                color: app.text_secondary_color
                background_color: [0, 0, 0, 0]
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: app.sage_container_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

            Button:
                text: "Pagar y activar Pro"
                size_hint_x: 0.58
                font_size: "14sp"
                bold: True
                color: [0.086, 0.149, 0.251, 1]
                background_color: [0, 0, 0, 0]
                on_release: root.confirm_upgrade()
                canvas.before:
                    Color:
                        rgba: [0.92, 0.58, 0.05, 1.0]
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]



# --------------------------------------------------------
# Hoja compacta: registrar cantidad y medida
# --------------------------------------------------------
<QuantitySheet>:
    height: content.minimum_height

    BoxLayout:
        id: content
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: ["20dp", "22dp", "20dp", "18dp"]
        spacing: "12dp"
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24, 24, 0, 0]

        BoxLayout:
            size_hint_y: None
            height: "26dp"
            Label:
                text: root.title_text
                font_size: "17sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
                shorten: True
                shorten_from: "right"
            Label:
                text: root.subtitle_text
                size_hint_x: None
                width: self.texture_size[0]
                font_size: "13sp"
                color: app.text_secondary_color
                halign: "right"
                valign: "middle"

        QuantityPicker:
            id: picker
            show_units: root.show_units
            integer_only: root.integer_only
            minimum: root.minimum

        Button:
            text: root.save_text
            size_hint_y: None
            height: "52dp"
            font_size: "15.5sp"
            bold: True
            color: [1, 1, 1, 1]
            background_color: [0, 0, 0, 0]
            background_normal: ""
            background_down: ""
            opacity: 0.85 if self.state == "down" else 1
            on_release: root.submit()
            canvas.before:
                Color:
                    rgba: app.accent_fill_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14, 14, 14, 14]
