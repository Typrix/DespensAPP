# -*- coding: utf-8 -*-
#:import numeric_input_filter controllers.validators.numeric_input_filter
# =========================================================
# Componentes Visuales Reutilizables - DespensAPP
# =========================================================

<BottomNavButton>:
    orientation: "vertical"
    size_hint_y: 1
    padding: ["2dp", "6dp", "2dp", "4dp"]
    spacing: "3dp"
    on_release: app.cambiar_pantalla(root.screen_target)

    # Indicador de pestaña activa: píldora solo detrás del ícono (estilo Android)
    AnchorLayout:
        size_hint_y: None
        height: "32dp"
        Widget:
            size_hint: None, None
            size: "60dp", "32dp"
            canvas.before:
                Color:
                    rgba: app.active_pill_color if root.is_active else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16, 16, 16, 16]
        MDIcon:
            icon: root.icon_name
            font_size: "23sp"
            theme_icon_color: "Custom"
            icon_color: app.accent_green_color if root.is_active else app.text_secondary_color
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

    Label:
        text: root.label_text
        font_size: "12sp"
        bold: root.is_active
        color: app.text_primary_color if root.is_active else app.text_secondary_color
        halign: "center"
        valign: "top"
        text_size: self.size


# Botón flotante (FAB) de agregar: abajo a la derecha, al alcance del pulgar
<AddCircleButton>:
    size_hint: None, None
    size: "56dp", "56dp"
    anchor_x: "center"
    anchor_y: "center"
    opacity: 0.88 if self.state == "down" else 1

    canvas.before:
        # Sombra suave en dos capas para separarlo del contenido
        Color:
            rgba: 0, 0, 0, 0.10
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [18, 18, 18, 18]
        Color:
            rgba: 0, 0, 0, 0.06
        RoundedRectangle:
            pos: self.x - dp(1), self.y - dp(6)
            size: self.width + dp(2), self.height + dp(2)
            radius: [19, 19, 19, 19]
        Color:
            rgba: app.accent_fill_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18, 18, 18, 18]

    MDIcon:
        icon: "plus"
        font_size: "26sp"
        theme_icon_color: "Custom"
        icon_color: [1, 1, 1, 1]
        pos_hint: {"center_x": 0.5, "center_y": 0.5}


<AvatarCircleButton>:
    size_hint: None, None
    size: "42dp", "42dp"
    anchor_x: "center"
    anchor_y: "center"

    canvas.before:
        Color:
            rgba: app.card_white_color
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.avatar_border_color
        Line:
            circle: (self.center_x, self.center_y, 20)
            width: 1.4

    Label:
        text: app.user_initials_str
        font_size: "13sp"
        bold: True
        color: app.text_primary_color


# ---------------------------------------------------------
# Fila de Artículo de la Despensa (Con Clasificación)
# ---------------------------------------------------------
<PantryItemRow>:
    size_hint_y: None
    height: "66dp"
    spacing: "10dp"
    opacity: 0.85 if self.state == "down" else 1
    on_release: root.open_detail()

    # Ícono según el producto; el tono indica la categoría
    ProductBadge:
        icon: root.icon
        tint: root.tint_dark if app.modo_oscuro else root.tint_light
        pos_hint: {"center_y": 0.5}

    # Nombre, cantidad + estado y vencimiento
    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        pos_hint: {"center_y": 0.5}
        padding: [0, "8dp", 0, "8dp"]
        spacing: "2dp"
        Label:
            text: root.name
            font_size: "15.5sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        BoxLayout:
            size_hint_y: None
            height: "18dp"
            spacing: "6dp"
            Label:
                text: root.status_str
                font_size: "12.5sp"
                bold: True
                color: app.legible(root.status_color, app.modo_oscuro)
                size_hint_x: None
                width: self.texture_size[0]
                halign: "left"
                valign: "middle"
            Label:
                text: f"· {root.expiration_str}" if root.expiration_str else ""
                font_size: "12sp"
                color: app.legible(root.expiration_color, app.modo_oscuro)
                size_hint_x: 1
                halign: "left"
                valign: "middle"
                text_size: self.size
                shorten: True
                shorten_from: "right"

    # Ajuste rápido: - cantidad +
    BoxLayout:
        size_hint_x: None
        width: "132dp"
        size_hint_y: None
        height: "40dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20, 20, 20, 20]
            Color:
                rgba: app.divider_color
            Line:
                rounded_rectangle: (self.x, self.y, self.width, self.height, dp(20))
                width: 1
        StockStepButton:
            text: "−"
            disabled: root.quantity_val <= 0
            on_release: root.quick_adjust(-1)
        # Tocar la cantidad abre la hoja para escribirla o cambiar la medida
        TapLabel:
            text: root.quantity_str
            font_size: "13.5sp"
            bold: True
            color: app.text_primary_color
            halign: "center"
            valign: "middle"
            text_size: self.size
            shorten: True
            on_release: root.open_quantity()
        StockStepButton:
            text: "+"
            on_release: root.quick_adjust(1)


# Insignia de producto: ícono con fondo suave del color de su categoría
<ProductBadge@AnchorLayout>:
    icon: "leaf"
    tint: [0.16, 0.52, 0.32, 1.0]
    badge_size: dp(38)
    radius: 12
    size_hint: None, None
    size: self.badge_size, self.badge_size
    canvas.before:
        Color:
            rgba: self.tint[:3] + [0.20 if app.modo_oscuro else 0.13]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius] * 4
    MDIcon:
        icon: root.icon
        font_size: root.badge_size * 0.53
        theme_icon_color: "Custom"
        icon_color: root.tint
        pos_hint: {"center_x": 0.5, "center_y": 0.5}


# Botón circular -/+ de la fila de despensa
<StockStepButton@ButtonBehavior+Label>:
    size_hint_x: None
    width: "40dp"
    font_size: "20sp"
    bold: True
    color: app.accent_green_color
    opacity: 0.35 if self.disabled else (0.6 if self.state == "down" else 1)
    disabled_color: app.text_secondary_color


# Chip de filtro de la despensa (activo = relleno verde)
<PantryFilterChip>:
    is_active: app.pantry_filter == self.filter_key
    size_hint: None, None
    height: "36dp"
    width: self.texture_size[0] + dp(32)
    font_size: "13sp"
    bold: self.is_active
    color: [1, 1, 1, 1] if self.is_active else app.text_secondary_color
    opacity: 0.8 if self.state == "down" else 1
    canvas.before:
        Color:
            rgba: app.accent_fill_color if self.is_active else app.card_white_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2.0] * 4
        # Borde sutil para que el chip blanco no se pierda sobre el fondo claro
        Color:
            rgba: (0, 0, 0, 0) if self.is_active else app.divider_color
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.height / 2.0)
            width: 1


# Encabezado de sección (Necesita atención / Por agotarse / Todo bien)
<PantrySectionHeader>:
    size_hint_y: None
    height: "40dp"
    spacing: "8dp"
    padding: [0, "14dp", 0, 0]
    Widget:
        size_hint: None, None
        size: "8dp", "8dp"
        pos_hint: {"center_y": 0.4}
        canvas.before:
            Color:
                rgba: root.dot_color
            Ellipse:
                pos: self.pos
                size: self.size
    Label:
        text: f"{root.title}  ·  {root.count}"
        font_size: "13sp"
        bold: True
        color: app.text_secondary_color
        halign: "left"
        valign: "middle"
        text_size: self.size


# ---------------------------------------------------------
# Tarjeta de Lista de Compras (Color Personalizado)
# ---------------------------------------------------------
<ShoppingListCard>:
    size_hint_y: None
    height: "76dp"
    padding: ["14dp", "12dp", "14dp", "12dp"]
    spacing: "12dp"
    on_release: root.open_detail()

    canvas.before:
        Color:
            rgba: app.card_white_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20, 20, 20, 20]

    # Insignia de Icono con Color Personalizado
    AnchorLayout:
        size_hint: None, None
        size: "42dp", "42dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: root.badge_bg_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12, 12, 12, 12]
        MDIcon:
            icon: root.icon_name
            theme_icon_color: "Custom"
            icon_color: root.icon_color_rgba
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

    # Información de la Lista
    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        pos_hint: {"center_y": 0.5}
        Label:
            text: root.list_name
            font_size: "14.5sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            text_size: self.size
        Label:
            text: root.info_subtitle
            font_size: "12.5sp"
            color: app.text_secondary_color
            halign: "left"
            text_size: self.size

    MDIcon:
        icon: "chevron-right"
        theme_icon_color: "Custom"
        icon_color: app.text_secondary_color
        pos_hint: {"center_y": 0.5}


# =========================================================
# Modal de Perfil Flotante
# =========================================================
<ProfileModalView>:
    size_hint: None, None
    size: "270dp", "260dp"
    pos_hint: {"top": 0.90, "right": 0.96}
    background_color: [0, 0, 0, 0]
    overlay_color: [0, 0, 0, 0.18]
    background: ""
    auto_dismiss: True

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1
        padding: ["16dp", "14dp", "16dp", "14dp"]
        spacing: "8dp"

        canvas.before:
            Color:
                rgba: [0, 0, 0, 0.12] if not app.modo_oscuro else [0, 0, 0, 0.4]
            RoundedRectangle:
                pos: [self.x - 2, self.y - 2]
                size: [self.width + 4, self.height + 4]
                radius: [22, 22, 22, 22]
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20, 20, 20, 20]

        # Encabezado Perfil: Avatar + Nombre + Email
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "12dp"

            AnchorLayout:
                size_hint: None, None
                size: "38dp", "38dp"
                pos_hint: {"center_y": 0.5}
                canvas.before:
                    Color:
                        rgba: app.leaf_badge_bg_color
                    Ellipse:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: app.avatar_border_color
                    Line:
                        circle: (self.center_x, self.center_y, 19)
                        width: 1.2
                Label:
                    text: app.user_initials_str
                    font_size: "12.5sp"
                    bold: True
                    color: app.text_primary_color

            BoxLayout:
                orientation: "vertical"
                pos_hint: {"center_y": 0.5}
                Label:
                    text: app.user_name_str
                    font_size: "13.5sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "left"
                    text_size: self.size
                Label:
                    text: app.user_email_str
                    font_size: "12sp"
                    color: app.text_secondary_color
                    halign: "left"
                    text_size: self.size

        # Línea Divisoria
        Widget:
            size_hint_y: None
            height: "1dp"
            canvas:
                Color:
                    rgba: app.divider_color
                Rectangle:
                    pos: self.pos
                    size: self.size

        # Opción 1: Cuenta / Iniciar Sesión
        Button:
            size_hint_y: None
            height: "32dp"
            background_color: [0, 0, 0, 0]
            on_release:
                app.cerrar_menu_perfil()
                app.abrir_modal_auth()
            BoxLayout:
                size: self.parent.size
                pos: self.parent.pos
                spacing: "12dp"
                MDIcon:
                    icon: "account-circle-outline"
                    theme_icon_color: "Custom"
                    icon_color: app.text_primary_color
                    pos_hint: {"center_y": 0.5}
                Label:
                    text: "Cuenta de usuario"
                    font_size: "13sp"
                    color: app.text_primary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                MDIcon:
                    icon: "chevron-right"
                    theme_icon_color: "Custom"
                    icon_color: app.text_secondary_color
                    pos_hint: {"center_y": 0.5}

        # Opción 2: Estado / Activación de Versión PRO
        Button:
            size_hint_y: None
            height: "32dp"
            background_color: [0, 0, 0, 0]
            on_release:
                app.cerrar_menu_perfil()
                app.abrir_modal_pro()
            BoxLayout:
                size: self.parent.size
                pos: self.parent.pos
                spacing: "12dp"
                MDIcon:
                    icon: "crown"
                    theme_icon_color: "Custom"
                    icon_color: [0.92, 0.58, 0.05, 1.0]
                    pos_hint: {"center_y": 0.5}
                Label:
                    text: "Versión PRO activa" if app.user_is_pro else "Obtener versión PRO"
                    font_size: "13sp"
                    bold: True
                    color: app.legible([0.92, 0.58, 0.05, 1.0], app.modo_oscuro) if app.user_is_pro else app.text_primary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                MDIcon:
                    icon: "check-decagram" if app.user_is_pro else "chevron-right"
                    theme_icon_color: "Custom"
                    icon_color: [0.92, 0.58, 0.05, 1.0] if app.user_is_pro else app.text_secondary_color
                    pos_hint: {"center_y": 0.5}

        # Opción 3: Modo oscuro (con Switch)
        BoxLayout:
            size_hint_y: None
            height: "36dp"
            spacing: "12dp"
            MDIcon:
                icon: "weather-night"
                theme_icon_color: "Custom"
                icon_color: app.text_primary_color
                pos_hint: {"center_y": 0.5}
            Label:
                text: "Modo oscuro"
                font_size: "13sp"
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            MDSwitch:
                active: app.modo_oscuro
                pos_hint: {"center_y": 0.5}
                on_active: app.cambiar_tema(self.active)

        # Opción 4: Cerrar Sesión
        Button:
            size_hint_y: None
            height: "32dp"
            background_color: [0, 0, 0, 0]
            on_release:
                app.cerrar_menu_perfil()
                app.cerrar_sesion_usuario()
            BoxLayout:
                size: self.parent.size
                pos: self.parent.pos
                spacing: "12dp"
                MDIcon:
                    icon: "logout"
                    theme_icon_color: "Custom"
                    icon_color: [0.85, 0.35, 0.35, 1.0]
                    pos_hint: {"center_y": 0.5}
                Label:
                    text: "Cerrar sesión"
                    font_size: "13sp"
                    color: [0.85, 0.35, 0.35, 1.0]
                    halign: "left"
                    valign: "middle"
                    text_size: self.size


<RemoteConfigBanner>:
    orientation: "horizontal"
    size_hint_y: None
    height: "76dp" if root.is_active else "0dp"
    opacity: 1 if root.is_active else 0
    disabled: not root.is_active
    padding: ["14dp", "10dp", "12dp", "10dp"]
    spacing: "10dp"

    canvas.before:
        Color:
            rgba: [0.18, 0.49, 0.38, 0.12] if root.is_active else [0, 0, 0, 0]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18, 18, 18, 18]
        Color:
            rgba: [0.18, 0.49, 0.38, 0.35] if root.is_active else [0, 0, 0, 0]
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 18)
            width: 1

    # Icono destacado / badge
    AnchorLayout:
        size_hint: None, None
        size: "38dp", "38dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: app.accent_fill_color if root.is_active else [0, 0, 0, 0]
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12, 12, 12, 12]
        MDIcon:
            icon: "cloud-check-outline"
            theme_icon_color: "Custom"
            icon_color: [1, 1, 1, 1]
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

    # Bloque de textos
    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        pos_hint: {"center_y": 0.5}
        spacing: "2dp"

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "18dp"
            spacing: "6dp"

            Label:
                text: root.title
                font_size: "12sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                size_hint_x: 1
                text_size: self.size

            # Mini badge
            Label:
                text: root.badge_text
                font_size: "8.5sp"
                bold: True
                color: app.accent_green_color
                size_hint: None, None
                size: self.texture_size[0] + 10, "16dp"
                halign: "center"
                valign: "middle"
                canvas.before:
                    Color:
                        rgba: app.leaf_badge_bg_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [6, 6, 6, 6]

        Label:
            text: root.message
            font_size: "12sp"
            color: app.text_secondary_color
            halign: "left"
            valign: "top"
            text_size: self.width, None
            size_hint_y: None
            height: "34dp"

    # Botón de recarga rápida (micro-interacción para demo)
    AnchorLayout:
        size_hint: None, None
        size: "32dp", "32dp"
        pos_hint: {"center_y": 0.5}
        Button:
            background_color: [0, 0, 0, 0]
            size: self.parent.size
            pos: self.parent.pos
            on_release: app.actualizar_config_remota()
            MDIcon:
                icon: "refresh"
                theme_icon_color: "Custom"
                icon_color: app.accent_green_color
                pos_hint: {"center_x": 0.5, "center_y": 0.5}



# ---------------------------------------------------------
# Píldora de Periodo (Mes / 3 meses / 6 meses / Año) en Estadísticas
# ---------------------------------------------------------
<PeriodChip@ButtonBehavior+AnchorLayout>:
    text: ""
    period: "month"
    requires_pro: False
    is_active: app.stats_period == self.period
    is_locked: self.requires_pro and not app.user_is_pro
    on_release: app.cambiar_periodo_estadisticas(self.period)
    canvas.before:
        Color:
            rgba: app.accent_fill_color if self.is_active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

    BoxLayout:
        size_hint: None, None
        size: self.minimum_width, dp(24)
        spacing: "3dp" if root.is_locked else "0dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Label:
            text: root.text
            size_hint_x: None
            width: self.texture_size[0]
            font_size: "12sp"
            bold: root.is_active
            color: [1, 1, 1, 1] if root.is_active else app.text_secondary_color
            valign: "middle"

        AnchorLayout:
            size_hint: None, None
            size: (dp(25), dp(14)) if root.is_locked else (0, 0)
            opacity: 1 if root.is_locked else 0
            pos_hint: {"center_y": 0.5}
            canvas.before:
                Color:
                    rgba: [0.92, 0.58, 0.05, 0.18] if root.is_locked else [0, 0, 0, 0]
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [5, 5, 5, 5]
            Label:
                text: "PRO" if root.is_locked else ""
                font_size: "7.5sp"
                bold: True
                color: [0.88, 0.52, 0.04, 1.0]


# ---------------------------------------------------------
# Tarjeta y Zona Tocable Genéricas (Inicio, filas del carrito)
# ---------------------------------------------------------
<TapLabel@ButtonBehavior+Label>:
    opacity: 0.6 if self.state == "down" else 1

<TapCard@ButtonBehavior+BoxLayout>:
    opacity: 0.8 if self.state == "down" else 1

<TapArea@ButtonBehavior+BoxLayout>:
    opacity: 0.7 if self.state == "down" else 1


# ---------------------------------------------------------
# Fila del Historial de Compras
# ---------------------------------------------------------
<PurchaseHistoryRow>:
    size_hint_y: None
    height: "44dp"
    spacing: "8dp"

    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.title
            font_size: "13sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "bottom"
            text_size: self.size
            shorten: True
            shorten_from: "right"
        Label:
            text: root.detail
            font_size: "12sp"
            color: app.text_secondary_color
            halign: "left"
            valign: "top"
            text_size: self.size

    Label:
        text: root.price_str
        size_hint_x: None
        width: "76dp"
        font_size: "13.5sp"
        bold: True
        color: app.text_primary_color
        halign: "right"
        valign: "middle"
        text_size: self.size


# ---------------------------------------------------------
# Estado Vacío con Acción (Compras, Despensa, Listas, Historial)
# ---------------------------------------------------------
<EmptyState>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: ["12dp", "18dp", "12dp", "14dp"]
    spacing: "6dp"

    AnchorLayout:
        size_hint_y: None
        height: "52dp"
        AnchorLayout:
            size_hint: None, None
            size: "52dp", "52dp"
            canvas.before:
                Color:
                    rgba: app.leaf_badge_bg_color
                Ellipse:
                    pos: self.pos
                    size: self.size
            MDIcon:
                icon: root.icon
                theme_icon_color: "Custom"
                icon_color: app.accent_green_color
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

    Label:
        text: root.title
        font_size: "15sp"
        bold: True
        color: app.text_primary_color
        size_hint_y: None
        height: "24dp"
        halign: "center"
        valign: "middle"
        text_size: self.size

    Label:
        text: root.message
        font_size: "12sp"
        color: app.text_secondary_color
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
        halign: "center"
        text_size: self.width, None

    AnchorLayout:
        size_hint_y: None
        height: "48dp" if root.action_text else 0
        opacity: 1 if root.action_text else 0
        disabled: not root.action_text

        Button:
            text: root.action_text
            font_size: "13sp"
            bold: True
            size_hint: None, None
            size: max(dp(150), self.texture_size[0] + dp(32)), dp(38)
            color: [1, 1, 1, 1]
            background_color: [0, 0, 0, 0]
            on_release: root.run_action()
            canvas.before:
                Color:
                    rgba: app.accent_fill_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]


# ---------------------------------------------------------
# Tarjeta de Lista en el Historial de Compras
# ---------------------------------------------------------
<PurchaseGroupCard>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: ["14dp", "12dp", "14dp", "8dp"]
    spacing: "4dp"
    opacity: 0.85 if self.tappable and self.state == "down" else 1
    canvas.before:
        Color:
            rgba: app.sage_container_color if self.in_modal else app.card_white_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16, 16, 16, 16]

    BoxLayout:
        size_hint_y: None
        height: "40dp"
        spacing: "10dp"

        AnchorLayout:
            size_hint: None, None
            size: "34dp", "34dp"
            pos_hint: {"center_y": 0.5}
            canvas.before:
                Color:
                    rgba: app.leaf_badge_bg_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10, 10, 10, 10]
            MDIcon:
                icon: "basket-outline" if root.name == "Compras sueltas" else "clipboard-text-outline"
                theme_icon_color: "Custom"
                icon_color: app.accent_green_color
                font_size: "18sp"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

        BoxLayout:
            orientation: "vertical"
            Label:
                text: root.name
                font_size: "14sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "bottom"
                text_size: self.size
                shorten: True
                shorten_from: "right"
            Label:
                text: root.info
                font_size: "12sp"
                color: app.text_secondary_color
                halign: "left"
                valign: "top"
                text_size: self.size

        Label:
            text: root.subtotal_str
            size_hint_x: None
            width: "84dp"
            font_size: "15sp"
            bold: True
            color: app.text_primary_color
            halign: "right"
            valign: "middle"
            text_size: self.size

    # Separador
    Widget:
        size_hint_y: None
        height: "1dp"
        canvas.before:
            Color:
                rgba: app.divider_color
            Rectangle:
                pos: self.pos
                size: self.size

    BoxLayout:
        id: rows_box
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height


# ---------------------------------------------------------
# Selector compacto de cantidad y medida
# ---------------------------------------------------------
# Píldora de medida (un., kg, L...) o de atajo de cantidad
<UnitChip>:
    size_hint: None, None
    height: "40dp"
    width: max(self.texture_size[0] + dp(28), dp(48))
    font_size: "14sp"
    bold: self.is_active
    color: [1, 1, 1, 1] if self.is_active else app.text_primary_color
    opacity: 0.8 if self.state == "down" else 1
    canvas.before:
        Color:
            rgba: app.accent_fill_color if self.is_active else app.card_white_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20, 20, 20, 20]
        Color:
            rgba: (0, 0, 0, 0) if self.is_active else app.divider_color
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(20))
            width: 1

# Botón cuadrado − / + del selector (48dp, cómodo para el pulgar)
<QtyStepButton@ButtonBehavior+AnchorLayout>:
    icon: "plus"
    size_hint: None, None
    size: "52dp", "52dp"
    opacity: 0.7 if self.state == "down" else 1
    canvas.before:
        Color:
            rgba: app.active_pill_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14, 14, 14, 14]
    MDIcon:
        icon: root.icon
        font_size: "24sp"
        theme_icon_color: "Custom"
        icon_color: app.accent_green_color
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

<SmallFieldLabel@Label>:
    size_hint_y: None
    height: "20dp"
    font_size: "13sp"
    color: app.text_secondary_color
    halign: "left"
    valign: "middle"
    text_size: self.size

<UnitChipRow>:
    size_hint_y: None
    height: "42dp"
    do_scroll_y: False
    bar_width: 0
    BoxLayout:
        id: units_box
        size_hint_x: None
        width: self.minimum_width
        spacing: "8dp"
        padding: [0, "1dp", 0, "1dp"]

<QuantityPicker>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: "8dp"

    SmallFieldLabel:
        text: "Medida"
        height: "20dp" if root.show_units else 0
        opacity: 1 if root.show_units else 0

    # Fila de medidas que se desliza hacia el lado si no caben
    UnitChipRow:
        unit: root.unit
        height: "42dp" if root.show_units else 0
        opacity: 1 if root.show_units else 0
        disabled: not root.show_units
        on_select: root.select_unit(args[1])

    SmallFieldLabel:
        text: root.quantity_label

    BoxLayout:
        size_hint_y: None
        height: "52dp"
        spacing: "10dp"

        QtyStepButton:
            icon: "minus"
            on_release: root.step_by(-1)

        # Número escribible + medida elegida
        BoxLayout:
            padding: ["12dp", 0, "12dp", 0]
            spacing: "6dp"
            canvas.before:
                Color:
                    rgba: app.card_white_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14, 14, 14, 14]
                Color:
                    rgba: app.legible([0.85, 0.20, 0.25, 1.0], app.modo_oscuro) if root.error_text else app.accent_green_color
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
                    width: 1.4
            Widget:
            TextInput:
                id: qty_input
                size_hint_x: None
                # Ancho según lo escrito: el número y la medida quedan centrados juntos
                width: min(dp(140), max(dp(28), self._get_text_width(self.text or "0", self.tab_width, self._label_cached) + dp(10)))
                multiline: False
                write_tab: False
                input_filter: numeric_input_filter
                input_type: "number"
                font_size: "22sp"
                bold: True
                halign: "center"
                background_normal: ""
                background_active: ""
                background_color: [0, 0, 0, 0]
                foreground_color: app.text_primary_color
                cursor_color: app.accent_green_color
                padding: [0, (self.height - self.line_height) / 2.0, 0, 0]
                on_text: root.on_typed(self.text)
                on_focus: root.on_input_focus(self.focus)
            Label:
                text: root.unit_label
                size_hint_x: None
                width: self.texture_size[0] if self.text else 0
                font_size: "16sp"
                bold: True
                color: app.accent_green_color
            Widget:

        QtyStepButton:
            icon: "plus"
            on_release: root.step_by(1)

    Label:
        text: root.error_text
        size_hint_y: None
        height: (self.texture_size[1] + dp(2)) if root.error_text else 0
        opacity: 1 if root.error_text else 0
        font_size: "13sp"
        color: app.legible([0.85, 0.20, 0.25, 1.0], app.modo_oscuro)
        halign: "left"
        text_size: self.width, None

    # Atajos de cantidad según la medida
    BoxLayout:
        id: quick_box
        size_hint_y: None
        height: "40dp"
        spacing: "8dp"
