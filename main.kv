#:import FadeTransition kivy.uix.screenmanager.FadeTransition
#:import SlideTransition kivy.uix.screenmanager.SlideTransition

# =========================================================
# Inclusión de Componentes y Pantallas Modulares - DespensAPP
# =========================================================
#:include kv/components.kv
#:include kv/screens/splash_screen.kv
#:include kv/screens/home_screen.kv
#:include kv/screens/pantry_screen.kv
#:include kv/screens/lists_screen.kv
#:include kv/screens/stats_screen.kv

# =========================================================
# Raíz de la Aplicación (Administrador Global de Pantallas)
# =========================================================

ScreenManager:
    id: root_screen_manager
    transition: FadeTransition(duration=0.25, clearcolor=app.bg_color)

    # -----------------------------------------------------
    # 0. Pantalla de Bienvenida y Carga (Splash Screen)
    # -----------------------------------------------------
    SplashScreen:
        name: "splash"

    # -----------------------------------------------------
    # 1. Contenedor Principal de la Aplicación
    # -----------------------------------------------------
    MDScreen:
        name: "main_app"

        BoxLayout:
            orientation: "vertical"
            size_hint: 1, 1

            canvas.before:
                Color:
                    rgba: app.bg_color
                Rectangle:
                    pos: self.pos
                    size: self.size

            # -------------------------------------------------
            # Encabezado Superior (Logo + Título + Campana + Avatar)
            # -------------------------------------------------
            BoxLayout:
                size_hint_y: None
                height: "64dp"
                padding: ["16dp", "10dp", "12dp", "10dp"]
                spacing: "10dp"

                # Logo compacto (marca) y nombre de la app
                AnchorLayout:
                    size_hint: None, None
                    size: "38dp", "38dp"
                    pos_hint: {"center_y": 0.5}
                    canvas.before:
                        StencilPush
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [11, 11, 11, 11]
                        StencilUse
                        Color:
                            rgba: 0.063, 0.141, 0.325, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    canvas.after:
                        StencilUnUse
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [11, 11, 11, 11]
                        StencilPop

                    Image:
                        source: "docs/despensapp_logo.png"
                        fit_mode: "contain"

                Label:
                    text: "DespensAPP"
                    font_size: "18sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Campana de Alertas Global (al lado del círculo de cuenta)
                FloatLayout:
                    size_hint: None, None
                    size: "46dp", "46dp"
                    pos_hint: {"center_y": 0.5}

                    TapCard:
                        size_hint: None, None
                        size: "42dp", "42dp"
                        pos: self.parent.x, self.parent.y + dp(2)
                        on_release: app.abrir_alertas()
                        canvas.before:
                            Color:
                                rgba: app.card_white_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14, 14, 14, 14]
                        AnchorLayout:
                            MDIcon:
                                icon: "bell-outline"
                                font_size: "22sp"
                                theme_text_color: "Custom"
                                text_color: app.accent_green_color
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    Label:
                        text: str(app.alerts_count) if app.alerts_count < 10 else "9+"
                        font_size: "10sp"
                        bold: True
                        color: [1, 1, 1, 1]
                        size_hint: None, None
                        size: "20dp", "20dp"
                        pos: self.parent.right - dp(20), self.parent.top - dp(20)
                        opacity: 1 if app.alerts_count else 0
                        canvas.before:
                            Color:
                                rgba: app.bg_color
                            Ellipse:
                                pos: self.pos
                                size: self.size
                            Color:
                                rgba: [0.85, 0.20, 0.25, 1.0]
                            Ellipse:
                                pos: self.x + dp(2), self.y + dp(2)
                                size: self.width - dp(4), self.height - dp(4)

                # Avatar Circular de Usuario
                AvatarCircleButton:
                    pos_hint: {"center_y": 0.5}
                    on_release: app.toggle_menu_perfil()

            # -------------------------------------------------
            # Administrador de Pantallas Interno (cada pantalla incluye su tarjeta redondeada)
            # -------------------------------------------------
            ScreenManager:
                id: screen_manager
                size_hint: 1, 1
                transition: SlideTransition(duration=0.22)

                HomeScreen:
                PantryScreen:
                ListsScreen:
                StatsScreen:

            # -------------------------------------------------
            # Barra de Navegación Inferior (5 Pestañas)
            # -------------------------------------------------
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "72dp"
                padding: ["8dp", "0dp", "8dp", "6dp"]
                spacing: "4dp"

                canvas.before:
                    Color:
                        rgba: app.bg_color
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: app.divider_color
                    Rectangle:
                        pos: self.x, self.top - dp(1)
                        size: self.width, dp(1)

                BottomNavButton:
                    icon_name: "home-outline"
                    label_text: "Inicio"
                    screen_target: "home"
                    is_active: app.current_screen_name == "home"

                BottomNavButton:
                    icon_name: "cupboard-outline"
                    label_text: "Despensa"
                    screen_target: "cupboard"
                    is_active: app.current_screen_name == "cupboard"

                BottomNavButton:
                    icon_name: "clipboard-text-outline"
                    label_text: "Listas"
                    screen_target: "lists"
                    is_active: app.current_screen_name == "lists"

                BottomNavButton:
                    icon_name: "finance"
                    label_text: "Estadísticas"
                    screen_target: "stats"
                    is_active: app.current_screen_name == "stats"