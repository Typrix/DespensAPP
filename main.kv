#:import FadeTransition kivy.uix.screenmanager.FadeTransition

# =========================================================
# Plantillas y Componentes de Interfaz
# =========================================================

<BottomNavButton>:
    orientation: "vertical"
    size_hint_y: 1
    padding: ["4dp", "4dp", "4dp", "4dp"]
    spacing: "2dp"
    on_release: app.cambiar_pantalla(root.screen_target)

    canvas.before:
        Color:
            rgba: app.active_pill_color if root.is_active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16, 16, 16, 16]

    AnchorLayout:
        size_hint_y: 0.6
        MDIcon:
            icon: root.icon_name
            theme_text_color: "Custom"
            text_color: app.accent_green_color if root.is_active else app.text_secondary_color
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

    Label:
        text: root.label_text
        size_hint_y: 0.4
        font_size: "10.5sp"
        bold: root.is_active
        color: app.accent_green_color if root.is_active else app.text_secondary_color
        halign: "center"
        valign: "middle"
        text_size: self.size


<AddCircleButton>:
    size_hint: None, None
    size: "40dp", "40dp"
    anchor_x: "center"
    anchor_y: "center"

    canvas.before:
        Color:
            rgba: app.accent_green_color
        Ellipse:
            pos: self.pos
            size: self.size

    MDIcon:
        icon: "plus"
        theme_text_color: "Custom"
        text_color: [1, 1, 1, 1]


<AvatarCircleButton>:
    size_hint: None, None
    size: "42dp", "42dp"
    anchor_x: "center"
    anchor_y: "center"

    canvas.before:
        Color:
            rgba: app.card_white_color
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.avatar_border_color
        Line:
            circle: (self.center_x, self.center_y, 20)
            width: 1.4

    Label:
        text: "SO"
        font_size: "13sp"
        bold: True
        color: app.text_primary_color


<CartItemRow>:
    size_hint_y: None
    height: "54dp"
    spacing: "14dp"
    padding: ["0dp", "4dp", "0dp", "4dp"]

    AnchorLayout:
        size_hint: None, None
        size: "30dp", "46dp"
        MDIcon:
            icon: "check-circle" if root.checked else "circle-outline"
            theme_text_color: "Custom"
            text_color: app.accent_green_color if root.checked else app.text_secondary_color

    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        pos_hint: {"center_y": 0.5}
        Label:
            text: root.title
            font_size: "14sp"
            bold: True
            color: app.text_primary_color
            halign: "left"
            valign: "middle"
            text_size: self.size
        Label:
            text: root.subtitle
            font_size: "11sp"
            color: app.text_secondary_color
            halign: "left"
            valign: "middle"
            text_size: self.size

    Label:
        text: root.price_str
        size_hint_x: None
        width: "70dp"
        font_size: "14.5sp"
        color: app.text_primary_color
        halign: "right"
        valign: "middle"
        text_size: self.size


# =========================================================
# Modal de Perfil Flotante (Sin bloquear toques cuando cierra)
# =========================================================

<ProfileModalView>:
    size_hint: None, None
    size: "264dp", "230dp"
    pos_hint: {"top": 0.90, "right": 0.96}
    background_color: [0, 0, 0, 0.25]
    background: ""
    auto_dismiss: True

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1
        padding: ["16dp", "14dp", "16dp", "14dp"]
        spacing: "8dp"

        canvas.before:
            Color:
                rgba: [0, 0, 0, 0.12] if not app.modo_oscuro else [0, 0, 0, 0.4]
            RoundedRectangle:
                pos: [self.x - 2, self.y - 2]
                size: [self.width + 4, self.height + 4]
                radius: [22, 22, 22, 22]
            Color:
                rgba: app.card_white_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20, 20, 20, 20]

        # Encabezado Perfil: Avatar + Nombre + Email
        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "12dp"

            AnchorLayout:
                size_hint: None, None
                size: "38dp", "38dp"
                pos_hint: {"center_y": 0.5}
                canvas.before:
                    Color:
                        rgba: app.leaf_badge_bg_color
                    Ellipse:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: app.avatar_border_color
                    Line:
                        circle: (self.center_x, self.center_y, 19)
                        width: 1.2
                Label:
                    text: "SO"
                    font_size: "12.5sp"
                    bold: True
                    color: app.text_primary_color

            BoxLayout:
                orientation: "vertical"
                pos_hint: {"center_y": 0.5}
                Label:
                    text: "Sofía Martínez"
                    font_size: "14sp"
                    bold: True
                    color: app.text_primary_color
                    halign: "left"
                    text_size: self.size
                Label:
                    text: "sofia@despensapp.com"
                    font_size: "10.5sp"
                    color: app.text_secondary_color
                    halign: "left"
                    text_size: self.size

        # Línea Divisoria
        Widget:
            size_hint_y: None
            height: "1dp"
            canvas:
                Color:
                    rgba: app.divider_color
                Rectangle:
                    pos: self.pos
                    size: self.size

        # Opción 1: Mi perfil
        BoxLayout:
            size_hint_y: None
            height: "32dp"
            spacing: "12dp"
            MDIcon:
                icon: "cog-outline"
                theme_text_color: "Custom"
                text_color: app.text_primary_color
                pos_hint: {"center_y": 0.5}
            Label:
                text: "Mi perfil"
                font_size: "13sp"
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            MDIcon:
                icon: "chevron-right"
                theme_text_color: "Custom"
                text_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}

        # Opción 2: Notificaciones
        BoxLayout:
            size_hint_y: None
            height: "32dp"
            spacing: "12dp"
            MDIcon:
                icon: "clock-outline"
                theme_text_color: "Custom"
                text_color: app.text_primary_color
                pos_hint: {"center_y": 0.5}
            Label:
                text: "Notificaciones"
                font_size: "13sp"
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            MDIcon:
                icon: "chevron-right"
                theme_text_color: "Custom"
                text_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}

        # Opción 3: Modo oscuro (con Switch)
        BoxLayout:
            size_hint_y: None
            height: "36dp"
            spacing: "12dp"
            MDIcon:
                icon: "weather-night"
                theme_text_color: "Custom"
                text_color: app.text_primary_color
                pos_hint: {"center_y": 0.5}
            Label:
                text: "Modo oscuro"
                font_size: "13sp"
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            MDSwitch:
                active: app.modo_oscuro
                pos_hint: {"center_y": 0.5}
                on_active: app.cambiar_tema(self.active)

        # Opción 4: Preferencias
        BoxLayout:
            size_hint_y: None
            height: "32dp"
            spacing: "12dp"
            MDIcon:
                icon: "cog-outline"
                theme_text_color: "Custom"
                text_color: app.text_primary_color
                pos_hint: {"center_y": 0.5}
            Label:
                text: "Preferencias"
                font_size: "13sp"
                color: app.text_primary_color
                halign: "left"
                valign: "middle"
                text_size: self.size
            MDIcon:
                icon: "chevron-right"
                theme_text_color: "Custom"
                text_color: app.text_secondary_color
                pos_hint: {"center_y": 0.5}


# =========================================================
# Raíz de la Aplicación (Estructura Limpia y 100% Interactiva)
# =========================================================

BoxLayout:
    orientation: "vertical"
    size_hint: 1, 1

    canvas.before:
        Color:
            rgba: app.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

    # -------------------------------------------------
    # Encabezado Superior (Logo + Título + Avatar "SO")
    # -------------------------------------------------
    BoxLayout:
        size_hint_y: None
        height: "110dp"
        padding: ["16dp", "10dp", "16dp", "10dp"]
        spacing: "15dp"

        # Logo Principal DespensAPP con Recuadro Azul
        AnchorLayout:
            size_hint: None, None
            size: "90dp", "90dp"
            pos_hint: {"center_y": 0.5}
            canvas.before:
                Color:
                    rgba: app.leaf_badge_bg_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [22, 22, 22, 22]
            Image:
                source: "despensapp_logo.png"
                size_hint: None, None
                size: "140dp", "140dp"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                allow_stretch: True
                keep_ratio: True
                mipmap: True

        # Título y Subtítulo de Pantalla
        BoxLayout:
            orientation: "vertical"
            size_hint_x: 1
            pos_hint: {"center_y": 0.5}
            Label:
                text: "DespensAPP"
                font_size: "20sp"
                bold: True
                color: app.text_primary_color
                halign: "left"
                valign: "bottom"
                text_size: self.size
            Label:
                text: app.screen_header_tag
                font_size: "10sp"
                bold: True
                color: app.category_tag_color
                halign: "left"
                valign: "top"
                text_size: self.size

        # Avatar Circular de Usuario ("SO")
        AvatarCircleButton:
            pos_hint: {"center_y": 0.5}
            on_release: app.toggle_menu_perfil()

    # -------------------------------------------------
    # Contenedor Principal (Tarjeta Sabia Redondeada)
    # -------------------------------------------------
    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1
        padding: ["14dp", "4dp", "14dp", "8dp"]

        BoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            padding: ["16dp", "16dp", "16dp", "16dp"]
            spacing: "10dp"

            canvas.before:
                Color:
                    rgba: app.sage_container_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [28, 28, 28, 28]

            # =========================================
            # Administrador de Pantallas
            # =========================================
            ScreenManager:
                id: screen_manager
                transition: FadeTransition(duration=0.15)

                # -------------------------------------
                # 1. PANTALLA: ESTADÍSTICAS (stats)
                # -------------------------------------
                MDScreen:
                    name: "stats"

                    MDScrollView:
                        do_scroll_x: False
                        bar_width: 0

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            spacing: "14dp"

                            # Encabezado de Sección
                            BoxLayout:
                                size_hint_y: None
                                height: "46dp"

                                BoxLayout:
                                    orientation: "vertical"
                                    size_hint_x: 1
                                    Label:
                                        text: "ÚLTIMOS 30 DÍAS"
                                        font_size: "10sp"
                                        bold: True
                                        color: app.category_tag_color
                                        halign: "left"
                                        valign: "middle"
                                        text_size: self.size
                                    Label:
                                        text: "Tus estadísticas"
                                        font_size: "22sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        valign: "middle"
                                        text_size: self.size

                                AnchorLayout:
                                    size_hint: None, None
                                    size: "38dp", "38dp"
                                    pos_hint: {"center_y": 0.5}
                                    canvas.before:
                                        Color:
                                            rgba: app.card_white_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [12, 12, 12, 12]
                                    MDIcon:
                                        icon: "finance"
                                        theme_text_color: "Custom"
                                        text_color: app.accent_green_color
                                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                            # Tarjetas Resumen (Lado a Lado)
                            BoxLayout:
                                size_hint_y: None
                                height: "105dp"
                                spacing: "10dp"

                                # Tarjeta Verde Bosque
                                BoxLayout:
                                    orientation: "vertical"
                                    padding: ["14dp", "12dp", "14dp", "12dp"]
                                    spacing: "4dp"
                                    canvas.before:
                                        Color:
                                            rgba: app.chart_card_dark_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [18, 18, 18, 18]

                                    Label:
                                        text: "Gasto mensual"
                                        font_size: "11sp"
                                        color: app.chart_card_text_dim_color
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "$182.400"
                                        font_size: "20sp"
                                        bold: True
                                        color: [1, 1, 1, 1]
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "8% menos que el mes pasado"
                                        font_size: "9.5sp"
                                        color: app.chart_card_text_dim_color
                                        halign: "left"
                                        text_size: self.size

                                # Tarjeta Blanca Productos
                                BoxLayout:
                                    orientation: "vertical"
                                    padding: ["14dp", "12dp", "14dp", "12dp"]
                                    spacing: "4dp"
                                    canvas.before:
                                        Color:
                                            rgba: app.card_white_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [18, 18, 18, 18]

                                    Label:
                                        text: "Productos comprados"
                                        font_size: "10.5sp"
                                        color: app.text_secondary_color
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "47"
                                        font_size: "23sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "En 6 compras"
                                        font_size: "9.5sp"
                                        color: app.text_secondary_color
                                        halign: "left"
                                        text_size: self.size

                            # Subtítulo: Lo Más Comprado
                            Label:
                                text: "LO MÁS COMPRADO"
                                size_hint_y: None
                                height: "22dp"
                                font_size: "10sp"
                                bold: True
                                color: app.category_tag_color
                                halign: "left"
                                valign: "middle"
                                text_size: self.size

                            # Item 01: Leche entera
                            BoxLayout:
                                orientation: "vertical"
                                size_hint_y: None
                                height: "38dp"
                                spacing: "6dp"
                                BoxLayout:
                                    Label:
                                        text: "01   "
                                        size_hint_x: None
                                        width: "28dp"
                                        font_size: "12sp"
                                        color: app.text_secondary_color
                                    Label:
                                        text: "Leche entera"
                                        font_size: "13.5sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "8 veces"
                                        size_hint_x: None
                                        width: "60dp"
                                        font_size: "11sp"
                                        color: app.text_secondary_color
                                        halign: "right"
                                        text_size: self.size
                                CustomProgressBar:
                                    value: 0.82
                                    track_color: app.progress_track_color
                                    fill_color: app.accent_green_color

                            # Item 02: Huevos
                            BoxLayout:
                                orientation: "vertical"
                                size_hint_y: None
                                height: "38dp"
                                spacing: "6dp"
                                BoxLayout:
                                    Label:
                                        text: "02   "
                                        size_hint_x: None
                                        width: "28dp"
                                        font_size: "12sp"
                                        color: app.text_secondary_color
                                    Label:
                                        text: "Huevos"
                                        font_size: "13.5sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        text_size: self.size
                                        valign: "middle"
                                    Label:
                                        text: "6 veces"
                                        size_hint_x: None
                                        width: "60dp"
                                        font_size: "11sp"
                                        color: app.text_secondary_color
                                        halign: "right"
                                        text_size: self.size
                                        valign: "middle"
                                CustomProgressBar:
                                    value: 0.62
                                    track_color: app.progress_track_color
                                    fill_color: app.accent_green_color

                            # Item 03: Arroz
                            BoxLayout:
                                orientation: "vertical"
                                size_hint_y: None
                                height: "38dp"
                                spacing: "6dp"
                                BoxLayout:
                                    Label:
                                        text: "03   "
                                        size_hint_x: None
                                        width: "28dp"
                                        font_size: "12sp"
                                        color: app.text_secondary_color
                                    Label:
                                        text: "Arroz"
                                        font_size: "13.5sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        text_size: self.size
                                        valign: "middle"
                                    Label:
                                        text: "5 veces"
                                        size_hint_x: None
                                        width: "60dp"
                                        font_size: "11sp"
                                        color: app.text_secondary_color
                                        halign: "right"
                                        text_size: self.size
                                        valign: "middle"
                                CustomProgressBar:
                                    value: 0.50
                                    track_color: app.progress_track_color
                                    fill_color: app.accent_green_color

                            # Tarjeta Inferior "Buen progreso"
                            BoxLayout:
                                size_hint_y: None
                                height: "68dp"
                                padding: ["14dp", "10dp", "14dp", "10dp"]
                                spacing: "12dp"
                                canvas.before:
                                    Color:
                                        rgba: app.card_white_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [18, 18, 18, 18]

                                AnchorLayout:
                                    size_hint: None, None
                                    size: "36dp", "46dp"
                                    MDIcon:
                                        icon: "leaf"
                                        theme_text_color: "Custom"
                                        text_color: app.accent_green_color

                                BoxLayout:
                                    orientation: "vertical"
                                    pos_hint: {"center_y": 0.5}
                                    Label:
                                        text: "Buen progreso"
                                        font_size: "13.5sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "Has aprovechado un 14% mejor tus alimentos este mes."
                                        font_size: "10.5sp"
                                        color: app.text_secondary_color
                                        halign: "left"
                                        text_size: self.size

                # -------------------------------------
                # 2. PANTALLA: LISTAS (lists)
                # -------------------------------------
                MDScreen:
                    name: "lists"

                    MDScrollView:
                        do_scroll_x: False
                        bar_width: 0

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            spacing: "14dp"

                            # Encabezado de Sección
                            BoxLayout:
                                size_hint_y: None
                                height: "46dp"

                                BoxLayout:
                                    orientation: "vertical"
                                    size_hint_x: 1
                                    Label:
                                        text: "ORGANIZACIÓN"
                                        font_size: "10sp"
                                        bold: True
                                        color: app.category_tag_color
                                        halign: "left"
                                        valign: "middle"
                                        text_size: self.size
                                    Label:
                                        text: "Mis listas"
                                        font_size: "22sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        valign: "middle"
                                        text_size: self.size

                                AddCircleButton:
                                    pos_hint: {"center_y": 0.5}
                                    on_release: app.accion_agregar()

                            # Tarjeta 1: Compra quincenal
                            BoxLayout:
                                size_hint_y: None
                                height: "76dp"
                                padding: ["14dp", "12dp", "14dp", "12dp"]
                                spacing: "12dp"
                                canvas.before:
                                    Color:
                                        rgba: app.card_white_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [20, 20, 20, 20]

                                AnchorLayout:
                                    size_hint: None, None
                                    size: "42dp", "42dp"
                                    pos_hint: {"center_y": 0.5}
                                    canvas.before:
                                        Color:
                                            rgba: app.leaf_badge_bg_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [12, 12, 12, 12]
                                    MDIcon:
                                        icon: "clipboard-text-outline"
                                        theme_text_color: "Custom"
                                        text_color: app.accent_green_color
                                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                                BoxLayout:
                                    orientation: "vertical"
                                    pos_hint: {"center_y": 0.5}
                                    Label:
                                        text: "Compra quincenal"
                                        font_size: "14.5sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "8 pendientes · 12 productos"
                                        font_size: "11sp"
                                        color: app.text_secondary_color
                                        halign: "left"
                                        text_size: self.size

                                MDIcon:
                                    icon: "chevron-right"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary_color
                                    pos_hint: {"center_y": 0.5}

                            # Tarjeta 2: Cena de cumpleaños
                            BoxLayout:
                                size_hint_y: None
                                height: "76dp"
                                padding: ["14dp", "12dp", "14dp", "12dp"]
                                spacing: "12dp"
                                canvas.before:
                                    Color:
                                        rgba: app.card_white_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [20, 20, 20, 20]

                                AnchorLayout:
                                    size_hint: None, None
                                    size: "42dp", "42dp"
                                    pos_hint: {"center_y": 0.5}
                                    canvas.before:
                                        Color:
                                            rgba: app.icon_badge_pink_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [12, 12, 12, 12]
                                    MDIcon:
                                        icon: "clipboard-text-outline"
                                        theme_text_color: "Custom"
                                        text_color: [0.72, 0.35, 0.30, 1]
                                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                                BoxLayout:
                                    orientation: "vertical"
                                    pos_hint: {"center_y": 0.5}
                                    Label:
                                        text: "Cena de cumpleaños"
                                        font_size: "14.5sp"
                                        bold: True
                                        color: app.text_primary_color
                                        halign: "left"
                                        text_size: self.size
                                    Label:
                                        text: "Sábado 24 · 6 productos"
                                        font_size: "11sp"
                                        color: app.text_secondary_color
                                        halign: "left"
                                        text_size: self.size

                                MDIcon:
                                    icon: "chevron-right"
                                    theme_text_color: "Custom"
