        padding: ["10dp", "4dp", "10dp", "4dp"]
        spacing: "6dp"

        canvas.before:
            Color:
                rgba: app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        BottomNavButton:
            icon_name: "home-outline"
            label_text: "Inicio"
            screen_target: "home"
            is_active: app.current_screen_name == "home"

        BottomNavButton:
